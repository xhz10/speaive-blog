# 对外访问地址。部署到 HTTPS 域名后需要修改，并重新构建前端镜像。
SPEAIVE_SITE_URL=http://127.0.0.1:4321

# 可选：在对应站长平台添加站点后，把 HTML meta 验证码填到这里。
# 只填写 content 属性中的验证码，不要粘贴整段 <meta> 标签。
SPEAIVE_GOOGLE_SITE_VERIFICATION=
SPEAIVE_BING_SITE_VERIFICATION=
SPEAIVE_BAIDU_SITE_VERIFICATION=

# Compose 对外端口；容器内 Astro 固定监听 4321。
SPEAIVE_PORT=4321

# PostgreSQL + pgvector。数据库密码请替换为随机长密码。
SPEAIVE_DB_NAME=speaive_blog
SPEAIVE_DB_USERNAME=speaive
SPEAIVE_DB_PASSWORD=replace-with-a-long-random-database-password

# Compose 将该目录绑定到后端容器的 /data；目录已被 Git 忽略。
# 服务器建议使用仓库外绝对路径，例如 /srv/speaive-blog/data。
SPEAIVE_DATA_DIR=.data

# 仅在不使用 Compose、直接运行 pnpm dev / pnpm start 时使用。
SPEAIVE_DB_HOST=127.0.0.1
SPEAIVE_DB_PORT=5432
SPEAIVE_BACKEND_URL=http://127.0.0.1:8080
SPEAIVE_BIND_ADDRESS=127.0.0.1
SPEAIVE_BACKEND_HOST=127.0.0.1
SPEAIVE_BACKEND_PORT=8080
SPEAIVE_TRUST_PROXY_HEADERS=false

SPEAIVE_ADMIN_USERNAME=admin

# 运行 `pnpm password:hash` 生成。必须保留单引号，避免 $ 被 shell 展开。
SPEAIVE_ADMIN_PASSWORD_HASH='$2y$12$replace-with-generated-bcrypt-hash'

# HTTPS 部署时改为 true；本地 HTTP 保持 false。
SPEAIVE_SECURE_COOKIES=false

# 可选：Session 7 天、Markdown 1 MiB、单张图片 8 MiB。
SPEAIVE_SESSION_TIMEOUT=7d
SPEAIVE_MAX_MARKDOWN_BYTES=1048576
SPEAIVE_MAX_IMAGE_BYTES=8388608
SPEAIVE_LOGIN_MAX_ATTEMPTS=5
SPEAIVE_LOGIN_WINDOW_SECONDS=900
SPEAIVE_LOGIN_MAX_TRACKED_ADDRESSES=10000

# AI 评论默认关闭，因此不配置模型也不会影响博客运行。
# 启用 OpenAI 或兼容 OpenAI Chat Completions 的服务时，同时修改前两项。
SPEAIVE_AI_ENABLED=false
SPEAIVE_AI_MODEL_CHAT=none
SPEAIVE_AI_API_KEY=
SPEAIVE_AI_BASE_URL=https://api.openai.com
SPEAIVE_AI_DEFAULT_MODEL=gpt-4.1-mini
SPEAIVE_AI_MAX_ARTICLE_CHARACTERS=24000
SPEAIVE_AI_RETRY_MAX_ATTEMPTS=2

# 会员 Agent 自动评论。只有公开文章、站长对文章显式开放、会员 Agent 已审核通过且订阅命中时才会排队。
SPEAIVE_AI_COMMUNITY_AUTOMATION_ENABLED=true
SPEAIVE_AI_COMMUNITY_SCAN_INTERVAL=15s
SPEAIVE_AI_COMMUNITY_BATCH_SIZE=3
SPEAIVE_AI_COMMUNITY_MAX_ATTEMPTS=3
SPEAIVE_AI_COMMUNITY_MAX_AGENTS_PER_POST=3
SPEAIVE_AI_COMMUNITY_MAX_AGENTS_PER_ACCOUNT=3

# scripts/docker-up.sh 会自动使用当前用户的 id -u / id -g。
# 直接执行 docker compose up 时可按宿主机用户手动设置这两个值。
# SPEAIVE_RUNTIME_UID=1000
# SPEAIVE_RUNTIME_GID=1000

# 可选：Docker Hub 不便访问时，可换成你自己的可信镜像仓库地址。
SPEAIVE_NODE_IMAGE=node:24-bookworm-slim
SPEAIVE_JAVA_BUILD_IMAGE=eclipse-temurin:25-jdk-noble
SPEAIVE_JAVA_RUNTIME_IMAGE=eclipse-temurin:25-jre-noble
SPEAIVE_POSTGRES_IMAGE=pgvector/pgvector:pg17

# 完整备份脚本会同时导出 PostgreSQL 和 SPEAIVE_DATA_DIR。
SPEAIVE_BACKUP_DIR=/var/backups/speaive-blog
SPEAIVE_BACKUP_RETENTION_DAYS=30
