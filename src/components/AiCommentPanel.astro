---
import { BookOpenText, RotateCcw, Sparkles, UsersRound } from "@lucide/astro";
import type { StudioPostDetail } from "../lib/studio/types";

interface Props {
  post?: StudioPostDetail;
}

const { post } = Astro.props;
---

<section class="ai-comment-panel" data-ai-comment-panel data-initial-slug={post?.slug ?? ""}>
  <div class="ai-comment-head">
    <div>
      <p class="studio-kicker">AI Comments</p>
      <h2>Agent 评论室</h2>
      <p>角色会参考文章摘要、同标签文章时间线和已有讨论。所有新评论仍需审核后才公开。</p>
    </div>
    <button class="button primary" type="button" data-generate-comments disabled>
      <Sparkles size={16} stroke-width={1.8} aria-hidden="true" />
      <span data-generate-label>生成评论</span>
    </button>
  </div>

  <section class="ai-summary-card" data-ai-summary-card aria-labelledby="ai-summary-title">
    <span class="ai-summary-icon" aria-hidden="true"><BookOpenText size={19} stroke-width={1.7} /></span>
    <div class="ai-summary-copy">
      <div class="ai-summary-title-line">
        <strong id="ai-summary-title">文章记忆摘要</strong>
        <span class="ai-summary-state" data-ai-summary-state>等待加载</span>
      </div>
      <p data-ai-summary-body>{post ? "正在读取这篇文章的摘要状态……" : "保存文章后即可生成摘要。"}</p>
      <small data-ai-summary-coverage>相关文章摘要库正在加载。</small>
    </div>
    <div class="ai-summary-actions">
      <button class="button secondary" type="button" data-refresh-summary disabled>生成摘要</button>
      <button class="button ghost" type="button" data-backfill-summaries disabled>
        <RotateCcw size={15} stroke-width={1.8} aria-hidden="true" />
        补齐历史摘要
      </button>
    </div>
  </section>

  <section class="ai-community-policy-card" data-community-policy-card>
    <span class="ai-summary-icon" aria-hidden="true"><UsersRound size={19} stroke-width={1.7} /></span>
    <div>
      <div class="ai-summary-title-line">
        <strong>社区 Agent 自动评论</strong>
        <span class="ai-summary-state" data-community-policy-state>等待加载</span>
      </div>
      <p data-community-policy-copy>只有你允许、会员 Agent 也关注这篇文章时，系统才会异步生成评论。</p>
      <small>会员 Agent 永远不能读取仅自己可见文章；生成结果仍然进入待审核。</small>
    </div>
    <button class="button secondary" type="button" data-community-policy-toggle disabled>允许自动评论</button>
  </section>

  <p class="notice" hidden data-ai-comment-notice></p>
  <div class="ai-agent-picker" data-ai-agent-picker>
    <p>{post ? "正在加载 Agent……" : "保存草稿后即可生成 Agent 评论。"}</p>
  </div>
  <div class="ai-comment-review" data-ai-comment-list>
    {post && <p class="agent-empty">正在加载评论……</p>}
  </div>
</section>

<script>
  import { studioRequest } from "../lib/studio/client";
  import type {
    AiSummaryCoverage,
    StudioAgent,
    StudioAgentList,
    StudioComment,
    StudioCommentList,
    StudioPostAiSummary,
    PostCommunityPolicy
  } from "../lib/studio/types";

  const panel = document.querySelector<HTMLElement>("[data-ai-comment-panel]");
  if (panel) setupAiCommentPanel(panel);

  function setupAiCommentPanel(root: HTMLElement) {
    const picker = root.querySelector<HTMLElement>("[data-ai-agent-picker]")!;
    const list = root.querySelector<HTMLElement>("[data-ai-comment-list]")!;
    const notice = root.querySelector<HTMLElement>("[data-ai-comment-notice]")!;
    const generateButton = root.querySelector<HTMLButtonElement>("[data-generate-comments]")!;
    const generateLabel = root.querySelector<HTMLElement>("[data-generate-label]")!;
    const summaryState = root.querySelector<HTMLElement>("[data-ai-summary-state]")!;
    const summaryBody = root.querySelector<HTMLElement>("[data-ai-summary-body]")!;
    const summaryCoverage = root.querySelector<HTMLElement>("[data-ai-summary-coverage]")!;
    const summaryButton = root.querySelector<HTMLButtonElement>("[data-refresh-summary]")!;
    const backfillButton = root.querySelector<HTMLButtonElement>("[data-backfill-summaries]")!;
    const communityState = root.querySelector<HTMLElement>("[data-community-policy-state]")!;
    const communityCopy = root.querySelector<HTMLElement>("[data-community-policy-copy]")!;
    const communityToggle = root.querySelector<HTMLButtonElement>("[data-community-policy-toggle]")!;
    let slug = root.dataset.initialSlug ?? "";
    let agents: StudioAgent[] = [];
    let latestComments: StudioComment[] = [];
    let aiAvailable = false;
    let busy = false;
    let communityPolicy: PostCommunityPolicy | null = null;

    if (slug) void load();
    document.addEventListener("studio:post-saved", (event) => {
      const savedSlug = (event as CustomEvent<{ slug?: string }>).detail?.slug;
      if (savedSlug) slug = savedSlug;
      if (slug) void Promise.all([refreshSummaryState(), refreshCommunityPolicy()]);
    });

    generateButton.addEventListener("click", () => void generateSelected());
    summaryButton.addEventListener("click", () => void generateSummary());
    backfillButton.addEventListener("click", () => void backfillSummaries());
    communityToggle.addEventListener("click", () => void toggleCommunityPolicy());
    document.querySelector("[data-visibility]")?.addEventListener("change", renderCommunityPolicy);
    list.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const replyButton = target.closest<HTMLButtonElement>("[data-generate-reply]");
      if (replyButton) {
        void generateReply(replyButton);
        return;
      }
      const action = target.closest<HTMLButtonElement>("[data-comment-action]");
      if (!action) return;
      if (action.dataset.commentAction === "reply") {
        toggleReplyComposer(action);
      } else {
        void moderate(action);
      }
    });

    async function load() {
      try {
        const [agentResult, commentResult, summaryResult, coverageResult, policyResult] = await Promise.all([
          studioRequest<StudioAgentList>("/studio/agents"),
          studioRequest<StudioCommentList>(`/studio/posts/${encodeURIComponent(slug)}/comments`),
          studioRequest<StudioPostAiSummary>(`/studio/posts/${encodeURIComponent(slug)}/ai-summary`),
          studioRequest<AiSummaryCoverage>("/studio/ai-summaries"),
          studioRequest<PostCommunityPolicy>(`/studio/posts/${encodeURIComponent(slug)}/community-agents`)
        ]);
        agents = agentResult.items;
        aiAvailable = agentResult.aiAvailable;
        renderAgents();
        renderComments(commentResult.items);
        renderSummary(summaryResult, coverageResult);
        communityPolicy = policyResult;
        renderCommunityPolicy();
      } catch (error) {
        showNotice(error instanceof Error ? error.message : "AI 评论区域加载失败", true);
      }
    }

    function renderAgents() {
      picker.replaceChildren();
      const savedVisibility = currentVisibility();
      const available = agents.filter((agent) => agent.enabled);
      if (available.length === 0) {
        const empty = document.createElement("p");
        empty.innerHTML = '还没有启用的 Agent。请先到 <a class="inline-link" href="/studio/agents/">Agent 管理</a> 创建角色。';
        picker.append(empty);
      } else {
        for (const agent of available) {
          const privateBlocked = savedVisibility === "ADMIN_ONLY" && !agent.canProcessPrivate;
          const label = document.createElement("label");
          label.className = "ai-agent-option";
          label.title = privateBlocked ? "这个 Agent 没有读取私密文章的权限" : agent.systemPrompt;
          const input = document.createElement("input");
          input.type = "checkbox";
          input.value = agent.id;
          input.disabled = privateBlocked || !aiAvailable;
          input.addEventListener("change", syncButtons);
          const copy = document.createElement("span");
          const name = document.createElement("strong");
          name.textContent = agent.displayName;
          const detail = document.createElement("small");
          detail.textContent = privateBlocked
            ? "未授权读取仅自己可见文章"
            : `@${agent.username}${agent.model ? ` · ${agent.model}` : ""}`;
          copy.append(name, detail);
          label.append(input, copy);
          picker.append(label);
        }
      }
      if (!aiAvailable) showNotice("Agent 配置可以正常管理，但服务器尚未启用 AI 模型。", true);
      syncButtons();
    }

    function renderComments(comments: StudioComment[]) {
      latestComments = comments;
      list.replaceChildren();
      if (comments.length === 0) {
        const empty = document.createElement("p");
        empty.className = "agent-empty";
        empty.textContent = "还没有 Agent 评论。";
        list.append(empty);
        return;
      }
      const byId = new Map(comments.map((comment) => [comment.id, comment]));
      for (const entry of flattenThread(comments)) {
        list.append(createCommentCard(entry.comment, byId, entry.depth));
      }
    }

    function createCommentCard(
      comment: StudioComment,
      byId: Map<string, StudioComment>,
      depth: number
    ): HTMLElement {
      const article = document.createElement("article");
      article.className = `ai-review-comment${comment.parentCommentId ? " reply" : " root"}`;
      article.dataset.commentId = comment.id;
      article.dataset.commentStatus = comment.status;
      article.style.setProperty("--comment-depth", String(Math.min(depth, 3)));
      const parent = comment.parentCommentId ? byId.get(comment.parentCommentId) : undefined;

      const head = document.createElement("header");
      head.className = "ai-review-comment-head";
      const avatar = document.createElement("span");
      avatar.className = "agent-avatar ai-review-avatar";
      avatar.setAttribute("aria-hidden", "true");
      if (comment.author.avatarUrl) {
        const image = document.createElement("img");
        image.src = comment.author.avatarUrl;
        image.alt = "";
        avatar.append(image);
      } else {
        avatar.textContent = comment.author.displayName.slice(0, 1);
      }
      const identity = document.createElement("div");
      identity.className = "ai-review-identity";
      const nameLine = document.createElement("div");
      nameLine.className = "ai-review-name-line";
      const author = document.createElement("strong");
      author.textContent = comment.author.displayName;
      const aiBadge = document.createElement("em");
      aiBadge.textContent = "AI";
      nameLine.append(author, aiBadge);
      const detail = document.createElement("small");
      detail.textContent = `@${comment.author.username} · ${formatCommentTime(comment.createdAt)}`;
      identity.append(nameLine, detail);
      const status = document.createElement("span");
      status.className = `comment-status ${comment.status.toLowerCase()}`;
      status.textContent = statusLabel(comment.status);
      head.append(avatar, identity, status);

      let relation: HTMLElement | null = null;
      if (parent) {
        relation = document.createElement("small");
        relation.className = "ai-reply-relation";
        relation.textContent = `↳ 接着 ${parent.author.displayName} 的话`;
      }
      const body = document.createElement("p");
      body.textContent = comment.body;
      const actions = document.createElement("div");
      actions.className = "button-row ai-review-actions";
      if (comment.status === "PENDING") actions.append(actionButton("publish", "发布到博客", comment.id));
      if (comment.status !== "HIDDEN") {
        actions.append(actionButton("reply", "安排角色回复", comment.id));
        actions.append(actionButton("hide", "隐藏", comment.id));
      }
      article.append(head);
      if (relation) article.append(relation);
      article.append(body, actions);
      return article;
    }

    function actionButton(action: "publish" | "hide" | "reply", label: string, id: string): HTMLButtonElement {
      const button = document.createElement("button");
      button.type = "button";
      button.className = action === "publish" ? "button secondary" : "button ghost";
      button.dataset.commentAction = action;
      button.dataset.commentId = id;
      button.textContent = label;
      return button;
    }

    function toggleReplyComposer(button: HTMLButtonElement) {
      const id = button.dataset.commentId;
      const article = id ? list.querySelector<HTMLElement>(`[data-comment-id="${CSS.escape(id)}"]`) : null;
      if (!id || !article || busy) return;
      const existing = article.querySelector<HTMLElement>("[data-reply-composer]");
      list.querySelectorAll<HTMLElement>("[data-reply-composer]").forEach((composer) => composer.remove());
      if (existing) return;
      const targetComment = latestComments.find((comment) => comment.id === id);
      const eligible = agents.filter((agent) => agent.enabled
        && agent.id !== targetComment?.author.id
        && (currentVisibility() !== "ADMIN_ONLY" || agent.canProcessPrivate));
      const composer = document.createElement("div");
      composer.className = "ai-reply-composer";
      composer.dataset.replyComposer = "";
      if (eligible.length === 0) {
        composer.textContent = "没有可用于回复的其他 Agent。";
      } else {
        const select = document.createElement("select");
        select.setAttribute("aria-label", "选择回复角色");
        for (const agent of eligible) {
          const option = document.createElement("option");
          option.value = agent.id;
          option.textContent = `${agent.displayName} · @${agent.username}`;
          select.append(option);
        }
        const submit = document.createElement("button");
        submit.type = "button";
        submit.className = "button primary";
        submit.dataset.generateReply = "";
        submit.dataset.commentId = id;
        submit.textContent = "生成回复";
        submit.disabled = !aiAvailable;
        composer.append(select, submit);
      }
      article.append(composer);
    }

    async function generateSelected() {
      const selected = Array.from(picker.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked'));
      if (!slug || selected.length === 0 || busy) return;
      if (editorIsDirty()) {
        showNotice("请先保存当前文章修改，再生成评论。", true);
        return;
      }
      setBusy(true);
      generateLabel.textContent = `正在生成 0/${selected.length}`;
      let completed = 0;
      let failed = 0;
      for (const input of selected) {
        try {
          await studioRequest<StudioComment>(`/studio/posts/${encodeURIComponent(slug)}/ai-comments`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ agentId: input.value })
          });
        } catch (error) {
          failed += 1;
          showNotice(error instanceof Error ? error.message : "评论生成失败", true);
        } finally {
          completed += 1;
          generateLabel.textContent = `正在生成 ${completed}/${selected.length}`;
        }
      }
      setBusy(false);
      generateLabel.textContent = "生成评论";
      if (failed === 0) showNotice(`${completed} 条评论已生成，审核后再发布。`);
      await Promise.all([refreshComments(), refreshSummaryState()]);
      renderAgents();
    }

    async function generateReply(button: HTMLButtonElement) {
      const id = button.dataset.commentId;
      const select = button.parentElement?.querySelector<HTMLSelectElement>("select");
      if (!id || !select?.value || busy) return;
      if (editorIsDirty()) {
        showNotice("请先保存当前文章修改，再生成回复。", true);
        return;
      }
      setBusy(true);
      button.textContent = "正在生成……";
      try {
        await studioRequest<StudioComment>(`/studio/comments/${encodeURIComponent(id)}/ai-replies`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ agentId: select.value })
        });
        showNotice("Agent 回复已生成，发布父评论后再按顺序审核回复。 ");
        await refreshComments();
      } catch (error) {
        showNotice(error instanceof Error ? error.message : "回复生成失败", true);
      } finally {
        setBusy(false);
      }
    }

    async function moderate(button: HTMLButtonElement) {
      const action = button.dataset.commentAction;
      const id = button.dataset.commentId;
      if ((action !== "publish" && action !== "hide") || !id || busy) return;
      setBusy(true);
      button.disabled = true;
      try {
        await studioRequest<StudioComment>(`/studio/comments/${encodeURIComponent(id)}/${action}`, { method: "POST" });
        showNotice(action === "publish" ? "评论已经公开。" : "评论及其后续回复已经隐藏。");
        await refreshComments();
      } catch (error) {
        showNotice(error instanceof Error ? error.message : "评论状态更新失败", true);
        button.disabled = false;
      } finally {
        setBusy(false);
      }
    }

    async function generateSummary() {
      if (!slug || busy || !aiAvailable) return;
      if (editorIsDirty()) {
        showNotice("请先保存当前文章修改，再生成摘要。", true);
        return;
      }
      if (currentVisibility() === "ADMIN_ONLY"
        && !window.confirm("生成摘要会把这篇仅自己可见文章的正文发送给你配置的 AI 服务，确定继续吗？")) return;
      setBusy(true);
      summaryButton.textContent = "正在生成……";
      try {
        const result = await studioRequest<StudioPostAiSummary>(
          `/studio/posts/${encodeURIComponent(slug)}/ai-summary`, { method: "POST" });
        const coverage = await studioRequest<AiSummaryCoverage>("/studio/ai-summaries");
        renderSummary(result, coverage);
        showNotice("文章记忆摘要已经更新。");
      } catch (error) {
        showNotice(error instanceof Error ? error.message : "摘要生成失败", true);
      } finally {
        setBusy(false);
      }
    }

    async function backfillSummaries() {
      if (busy || !aiAvailable) return;
      setBusy(true);
      backfillButton.textContent = "正在补齐……";
      try {
        let coverage: AiSummaryCoverage;
        do {
          coverage = await studioRequest<AiSummaryCoverage>("/studio/ai-summaries/backfill-next", { method: "POST" });
          summaryCoverage.textContent = coverageText(coverage);
          backfillButton.textContent = `还剩 ${coverage.missing + coverage.stale} 篇`;
        } while (coverage.missing + coverage.stale > 0);
        showNotice("所有公开文章的记忆摘要都已补齐。");
        await refreshSummaryState();
      } catch (error) {
        showNotice(error instanceof Error ? error.message : "历史摘要补齐中断，可以稍后继续", true);
      } finally {
        backfillButton.replaceChildren();
        backfillButton.textContent = "补齐历史摘要";
        setBusy(false);
      }
    }

    async function refreshComments() {
      const result = await studioRequest<StudioCommentList>(`/studio/posts/${encodeURIComponent(slug)}/comments`);
      renderComments(result.items);
    }

    async function refreshSummaryState() {
      const [summary, coverage] = await Promise.all([
        studioRequest<StudioPostAiSummary>(`/studio/posts/${encodeURIComponent(slug)}/ai-summary`),
        studioRequest<AiSummaryCoverage>("/studio/ai-summaries")
      ]);
      renderSummary(summary, coverage);
    }

    async function refreshCommunityPolicy() {
      communityPolicy = await studioRequest<PostCommunityPolicy>(
        `/studio/posts/${encodeURIComponent(slug)}/community-agents`);
      renderCommunityPolicy();
    }

    async function toggleCommunityPolicy() {
      if (!slug || !communityPolicy || busy) return;
      if (currentVisibility() !== "PUBLIC") {
        showNotice("仅公开文章可以开放给社区 Agent。", true);
        return;
      }
      setBusy(true);
      try {
        const nextEnabled = !communityPolicy.enabled;
        communityPolicy = await studioRequest<PostCommunityPolicy>(
          `/studio/posts/${encodeURIComponent(slug)}/community-agents`, {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ enabled: nextEnabled, version: communityPolicy.version })
          });
        renderCommunityPolicy();
        showNotice(nextEnabled
          ? `已允许社区 Agent 自动评论${communityPolicy.queuedAgents ? `，本次排队 ${communityPolicy.queuedAgents} 个角色` : "；符合条件的角色会在发布后排队"}。`
          : "已关闭社区 Agent 自动评论；已经生成的评论不会被删除。");
      } catch (error) {
        showNotice(error instanceof Error ? error.message : "社区 Agent 设置保存失败", true);
      } finally {
        setBusy(false);
      }
    }

    function renderCommunityPolicy() {
      const publicPost = currentVisibility() === "PUBLIC";
      communityState.className = `ai-summary-state ${communityPolicy?.enabled ? "current" : "missing"}`;
      communityState.textContent = communityPolicy?.enabled ? "已允许" : "未开放";
      communityCopy.textContent = !publicPost
        ? "当前文章仅自己可见，社区 Agent 入口已强制关闭。"
        : communityPolicy?.enabled
          ? "符合关注规则且已经通过审核的会员 Agent，会在文章发布后异步排队。"
          : "访客创建的 Agent 不会自动读取或评论这篇文章。";
      communityToggle.textContent = communityPolicy?.enabled ? "关闭自动评论" : "允许自动评论";
      communityToggle.disabled = busy || !slug || !communityPolicy || !publicPost;
    }

    function renderSummary(summary: StudioPostAiSummary, coverage: AiSummaryCoverage) {
      summaryState.className = `ai-summary-state ${summary.state.toLowerCase()}`;
      summaryState.textContent = summary.state === "CURRENT" ? "已同步"
        : summary.state === "STALE" ? "文章更新后待重做" : "尚未生成";
      summaryBody.textContent = summary.body ?? "还没有摘要。生成评论时会自动创建，也可以现在手动生成。";
      summaryCoverage.textContent = coverageText(coverage);
      summaryButton.textContent = summary.state === "MISSING" ? "生成摘要" : "更新摘要";
      syncButtons();
    }

    function coverageText(coverage: AiSummaryCoverage) {
      const remaining = coverage.missing + coverage.stale;
      return `公开文章摘要库：${coverage.current}/${coverage.total} 已同步${remaining ? `，还有 ${remaining} 篇待补齐` : ""}`;
    }

    function flattenThread(comments: StudioComment[]) {
      const byId = new Map(comments.map((comment) => [comment.id, comment]));
      const children = new Map<string, StudioComment[]>();
      const roots: StudioComment[] = [];
      for (const comment of comments) {
        if (comment.parentCommentId && byId.has(comment.parentCommentId)) {
          const siblings = children.get(comment.parentCommentId) ?? [];
          siblings.push(comment);
          children.set(comment.parentCommentId, siblings);
        } else {
          roots.push(comment);
        }
      }
      const result: Array<{ comment: StudioComment; depth: number }> = [];
      const visited = new Set<string>();
      const visit = (comment: StudioComment, depth: number) => {
        if (visited.has(comment.id)) return;
        visited.add(comment.id);
        result.push({ comment, depth: Math.min(depth, 3) });
        for (const child of children.get(comment.id) ?? []) visit(child, depth + 1);
      };
      for (const rootComment of roots) visit(rootComment, 0);
      for (const comment of comments) visit(comment, 0);
      return result;
    }

    function formatCommentTime(value: string): string {
      return new Intl.DateTimeFormat("zh-CN", {
        month: "numeric",
        day: "numeric",
        hour: "2-digit",
        minute: "2-digit"
      }).format(new Date(value));
    }

    function setBusy(value: boolean) {
      busy = value;
      syncButtons();
      root.querySelectorAll<HTMLButtonElement>("[data-comment-action], [data-generate-reply]")
        .forEach((button) => { button.disabled = value; });
    }

    function syncButtons() {
      const selected = picker.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:checked').length;
      generateButton.disabled = busy || !aiAvailable || selected === 0;
      summaryButton.disabled = busy || !aiAvailable || !slug;
      backfillButton.disabled = busy || !aiAvailable;
      renderCommunityPolicy();
    }

    function currentVisibility() {
      return document.querySelector<HTMLSelectElement>("[data-visibility]")?.value ?? "ADMIN_ONLY";
    }

    function editorIsDirty() {
      return document.querySelector<HTMLFormElement>("#post-form")?.dataset.dirty === "true";
    }

    function showNotice(message: string, error = false) {
      notice.textContent = message;
      notice.classList.toggle("error", error);
      notice.hidden = false;
    }

    function statusLabel(status: StudioComment["status"]): string {
      if (status === "PUBLISHED") return "已发布";
      if (status === "HIDDEN") return "已隐藏";
      return "待审核";
    }
  }
</script>
