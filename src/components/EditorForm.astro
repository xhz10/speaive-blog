---
import {
  Archive,
  Bold,
  Check,
  CodeXml,
  Eye,
  Heading2,
  ImagePlus,
  Italic,
  Link2,
  List,
  LockKeyhole,
  Quote,
  Save,
  Send,
  TriangleAlert,
  Undo2
} from "@lucide/astro";
import { formatDateTimeInput } from "../lib/date-time";
import type { StudioPostDetail } from "../lib/studio/types";
import AiCommentPanel from "./AiCommentPanel.astro";
import CreativeToolsPanel from "./CreativeToolsPanel.astro";

interface Props {
  post?: StudioPostDetail;
}

const { post } = Astro.props;
const initialState = JSON.stringify(post ?? null).replace(/</g, "\\u003c");
const publishedAt = formatDateTimeInput(post ? new Date(post.publishedAt) : new Date());
const previewHtml = post?.html.replace(
  /src="\/media\/([^"]+)"/g,
  (_match, path: string) => `src="/api/v1/studio/media/${path}"`
);
---

<form id="post-form" class="studio-editor-form" novalidate data-dirty="false" data-studio-editor-form>
  <div class="editor-commandbar">
    <div class="editor-state-line">
      <span class:list={["status-badge", { draft: !post || post.status === "DRAFT" }]} data-post-status>
        {post?.status === "PUBLISHED" ? "已发布" : "草稿"}
      </span>
      <span class:list={["visibility-badge", { private: !post || post.visibility === "ADMIN_ONLY" }]} data-post-visibility>
        <LockKeyhole size={13} stroke-width={1.9} aria-hidden="true" />
        <span data-post-visibility-label>{post?.visibility === "PUBLIC" ? "公开" : "仅自己"}</span>
      </span>
      <span class="save-indicator" data-save-indicator data-state={post ? "saved" : "dirty"} aria-live="polite">
        <span class="save-indicator-dot" aria-hidden="true"></span>
        <span data-save-label>{post ? "已保存" : "未保存"}</span>
      </span>
    </div>
    <div class="button-row editor-actions">
      <button class="button secondary" type="button" data-save-draft hidden={post?.status === "PUBLISHED"}>
        <Save size={16} stroke-width={1.8} aria-hidden="true" />
        保存草稿
      </button>
      <button class="button secondary" type="button" data-unpublish hidden={post?.status !== "PUBLISHED"}>
        <Undo2 size={16} stroke-width={1.8} aria-hidden="true" />
        撤回为草稿
      </button>
      <button class="button primary" type="button" data-publish>
        <Send size={16} stroke-width={1.8} aria-hidden="true" />
        <span data-publish-label>{post?.status === "PUBLISHED" ? "更新发布" : "发布"}</span>
      </button>
      <button class="icon-button" type="button" title="归档文章" aria-label="归档文章" data-archive hidden={!post}>
        <Archive size={17} stroke-width={1.8} aria-hidden="true" />
      </button>
    </div>
  </div>

  <div class="editor-alert" role="alert" hidden data-editor-error>
    <TriangleAlert size={17} stroke-width={1.8} aria-hidden="true" />
    <span data-editor-error-text></span>
    <a class="button ghost" href="/studio/login" target="_blank" rel="noreferrer" hidden data-login-again>重新登录</a>
    <button class="button ghost" type="button" hidden data-reload>重新加载</button>
  </div>

  <section class="editor-document-meta" aria-label="文章信息">
    <label class="visually-hidden" for="post-title">标题</label>
    <input
      id="post-title"
      class="editor-title-input"
      type="text"
      name="title"
      value={post?.title ?? ""}
      maxlength="200"
      placeholder="文章标题"
      required
      data-title
    />
    <label class="visually-hidden" for="post-description">摘要</label>
    <textarea
      id="post-description"
      class="editor-description-input"
      name="description"
      rows="2"
      maxlength="500"
      placeholder="写一句摘要，留空也可以"
      data-description
    >{post?.description ?? ""}</textarea>

    <div class="editor-metadata-grid">
      <label class="field slug-field">
        <span class="field-label">Slug</span>
        <div class="slug-input-wrap"><span>/blog/</span><input type="text" name="slug" value={post?.slug ?? ""} maxlength="100" pattern="[\p{L}\p{N}]+(?:-[\p{L}\p{N}]+)*" required readonly={Boolean(post)} data-slug /></div>
      </label>
      <label class="field">
        <span class="field-label">发布时间（北京时间）</span>
        <input class="input" type="datetime-local" name="publishedAt" value={publishedAt} step="1" required data-published-at />
      </label>
      <label class="field">
        <span class="field-label">谁可以看</span>
        <select class="input" name="visibility" data-visibility>
          <option value="ADMIN_ONLY" selected={!post || post.visibility === "ADMIN_ONLY"}>仅自己（管理员）</option>
          <option value="PUBLIC" selected={post?.visibility === "PUBLIC"}>所有访客</option>
        </select>
      </label>
      <div class="field">
        <span class="field-label">标签</span>
        <div class="tag-input-shell" data-tag-input-shell>
          <div class="tag-chip-list" data-tag-list aria-label="已添加的标签">
            {post?.tags.map((tag) => (
              <span class="tag-chip">
                <span>{tag}</span>
                <button type="button" aria-label={`删除标签 ${tag}`} data-remove-tag={tag}>×</button>
              </span>
            ))}
          </div>
          <input
            type="text"
            maxlength="40"
            placeholder="输入标签后按回车"
            aria-label="添加标签"
            autocomplete="off"
            data-tag-input
          />
        </div>
        <span class="field-hint">回车生成标签，最多 20 个</span>
      </div>
      <label class="field cover-field">
        <span class="field-label">封面</span>
        <input class="input" type="text" name="cover" value={post?.cover ?? ""} placeholder="上传图片后可以设为封面" data-cover />
      </label>
    </div>
  </section>

  <div class="editor-workspace">
    <section class="editor-pane" aria-labelledby="editor-title" data-drop-zone>
      <div class="editor-toolbar">
        <div>
          <strong id="editor-title">Markdown</strong>
          <span>正文</span>
        </div>
        <div class="button-row editor-tools">
          <label class="compact-checkbox" title="上传图片后同时设为文章封面">
            <input type="checkbox" aria-label="上传图片时设为封面" data-set-cover />
            <span>设为封面</span>
          </label>
          <input type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" hidden data-media-picker />
          <button class="icon-button" type="button" title="上传图片" aria-label="上传图片" data-upload-media>
            <ImagePlus size={17} stroke-width={1.8} aria-hidden="true" />
          </button>
        </div>
      </div>
      <div class="markdown-toolbar" role="toolbar" aria-label="Markdown 格式工具">
        <button type="button" title="二级标题" aria-label="插入二级标题" data-markdown-action="heading">
          <Heading2 size={16} stroke-width={1.8} aria-hidden="true" />
        </button>
        <button type="button" title="加粗（⌘/Ctrl+B）" aria-label="加粗" data-markdown-action="bold">
          <Bold size={16} stroke-width={1.8} aria-hidden="true" />
        </button>
        <button type="button" title="斜体（⌘/Ctrl+I）" aria-label="斜体" data-markdown-action="italic">
          <Italic size={16} stroke-width={1.8} aria-hidden="true" />
        </button>
        <button type="button" title="链接" aria-label="插入链接" data-markdown-action="link">
          <Link2 size={16} stroke-width={1.8} aria-hidden="true" />
        </button>
        <button type="button" title="无序列表" aria-label="插入无序列表" data-markdown-action="list">
          <List size={16} stroke-width={1.8} aria-hidden="true" />
        </button>
        <button type="button" title="引用" aria-label="插入引用" data-markdown-action="quote">
          <Quote size={16} stroke-width={1.8} aria-hidden="true" />
        </button>
        <button type="button" title="代码块" aria-label="插入代码块" data-markdown-action="code">
          <CodeXml size={16} stroke-width={1.8} aria-hidden="true" />
        </button>
        <span class="markdown-toolbar-hint">⌘/Ctrl+F 搜索</span>
      </div>
      <div class="media-result" hidden data-media-result>
        <Check size={15} stroke-width={1.8} aria-hidden="true" />
        <span data-media-message></span>
        <button type="button" data-use-cover>设为封面</button>
      </div>
      <textarea
        class="editor-textarea"
        name="body"
        aria-label="Markdown 正文"
        placeholder="从这里开始写……"
        spellcheck="true"
        data-body
      >{post?.body ?? ""}</textarea>
      <div class="markdown-editor-host" data-markdown-editor></div>
      <div class="markdown-editor-status" aria-live="polite">
        <span data-document-count>0 字 · 1 行</span>
        <span>Markdown</span>
      </div>
      <div class="drop-overlay" hidden data-drop-overlay>松开以上传图片</div>
    </section>

    <section class="preview-pane prose" aria-label="文章预览">
      <div class="editor-toolbar preview-toolbar">
        <div><strong>预览</strong><span data-preview-state>{post ? "已同步" : "等待正文"}</span></div>
        <button class="icon-button" type="button" title="立即刷新预览" aria-label="立即刷新预览" data-preview>
          <Eye size={17} stroke-width={1.8} aria-hidden="true" />
        </button>
      </div>
      <div class="preview-content" data-preview-pane>
        {previewHtml ? <Fragment set:html={previewHtml} /> : <div class="preview-placeholder"><span>预览会显示在这里</span></div>}
      </div>
    </section>
  </div>
  <AiCommentPanel post={post} />
  <CreativeToolsPanel contentType="POST" slug={post?.slug} version={post?.version} />
</form>

<script is:inline id="editor-initial-state" type="application/json" set:html={initialState}></script>

<script>
  import type { EditorView } from "@codemirror/view";
  import { formatDateTimeInput, normalizeInstant, parseDateTimeInput } from "../lib/date-time";
  import { StudioClientError, studioRequest } from "../lib/studio/client";
  import { createDraftTabId } from "../lib/studio/draft-id";
  import {
    applyMarkdownAction as applySharedMarkdownAction,
    createMarkdownEditor,
    toContentSlug
  } from "../lib/studio/markdown-editor";
  import type {
    CreatePostPayload,
    PostVisibility,
    PostWritePayload,
    SavedMedia,
    StudioPostDetail,
    UpdatePostPayload
  } from "../lib/studio/types";

  const NEW_DRAFT_KEY_PREFIX = "speaive:studio:new-draft:v2:";
  const NEW_DRAFT_TAB_KEY = "speaive:studio:new-draft-tab:v1";

  const form = document.querySelector<HTMLFormElement>("#post-form");
  const stateScript = document.querySelector<HTMLScriptElement>("#editor-initial-state");
  if (form && stateScript) {
    const parsed = JSON.parse(stateScript.textContent || "null") as StudioPostDetail | null;
    void setupEditor(form, parsed);
  }

  async function setupEditor(editorForm: HTMLFormElement, initialPost: StudioPostDetail | null) {
    const titleInput = editorForm.querySelector<HTMLInputElement>("[data-title]")!;
    const descriptionInput = editorForm.querySelector<HTMLTextAreaElement>("[data-description]")!;
    const slugInput = editorForm.querySelector<HTMLInputElement>("[data-slug]")!;
    const publishedAtInput = editorForm.querySelector<HTMLInputElement>("[data-published-at]")!;
    const visibilityInput = editorForm.querySelector<HTMLSelectElement>("[data-visibility]")!;
    const tagInputShell = editorForm.querySelector<HTMLElement>("[data-tag-input-shell]")!;
    const tagList = editorForm.querySelector<HTMLElement>("[data-tag-list]")!;
    const tagInput = editorForm.querySelector<HTMLInputElement>("[data-tag-input]")!;
    const coverInput = editorForm.querySelector<HTMLInputElement>("[data-cover]")!;
    const bodyInput = editorForm.querySelector<HTMLTextAreaElement>("[data-body]")!;
    const markdownHost = editorForm.querySelector<HTMLElement>("[data-markdown-editor]")!;
    const documentCount = editorForm.querySelector<HTMLElement>("[data-document-count]")!;
    const saveButton = editorForm.querySelector<HTMLButtonElement>("[data-save-draft]")!;
    const publishButton = editorForm.querySelector<HTMLButtonElement>("[data-publish]")!;
    const publishLabel = editorForm.querySelector<HTMLElement>("[data-publish-label]")!;
    const unpublishButton = editorForm.querySelector<HTMLButtonElement>("[data-unpublish]")!;
    const archiveButton = editorForm.querySelector<HTMLButtonElement>("[data-archive]")!;
    const statusBadge = editorForm.querySelector<HTMLElement>("[data-post-status]")!;
    const visibilityBadge = editorForm.querySelector<HTMLElement>("[data-post-visibility]")!;
    const visibilityLabel = editorForm.querySelector<HTMLElement>("[data-post-visibility-label]")!;
    const saveIndicator = editorForm.querySelector<HTMLElement>("[data-save-indicator]")!;
    const saveLabel = editorForm.querySelector<HTMLElement>("[data-save-label]")!;
    const errorBox = editorForm.querySelector<HTMLElement>("[data-editor-error]")!;
    const errorText = editorForm.querySelector<HTMLElement>("[data-editor-error-text]")!;
    const loginAgain = editorForm.querySelector<HTMLAnchorElement>("[data-login-again]")!;
    const reloadButton = editorForm.querySelector<HTMLButtonElement>("[data-reload]")!;
    const previewButton = editorForm.querySelector<HTMLButtonElement>("[data-preview]")!;
    const previewPane = editorForm.querySelector<HTMLElement>("[data-preview-pane]")!;
    const previewState = editorForm.querySelector<HTMLElement>("[data-preview-state]")!;
    const mediaButton = editorForm.querySelector<HTMLButtonElement>("[data-upload-media]")!;
    const mediaPicker = editorForm.querySelector<HTMLInputElement>("[data-media-picker]")!;
    const setCover = editorForm.querySelector<HTMLInputElement>("[data-set-cover]")!;
    const mediaResult = editorForm.querySelector<HTMLElement>("[data-media-result]")!;
    const mediaMessage = editorForm.querySelector<HTMLElement>("[data-media-message]")!;
    const useCoverButton = editorForm.querySelector<HTMLButtonElement>("[data-use-cover]")!;
    const dropZone = editorForm.querySelector<HTMLElement>("[data-drop-zone]")!;
    const dropOverlay = editorForm.querySelector<HTMLElement>("[data-drop-overlay]")!;

    if (!initialPost) publishedAtInput.value = formatDateTimeInput(new Date());

    let post = initialPost;
    let status = initialPost?.status ?? "DRAFT";
    let version = initialPost?.version ?? "";
    let slugTouched = Boolean(initialPost);
    let dirty = false;
    let conflicted = false;
    let busy = false;
    let autosaveTimer: number | undefined;
    let activeSave: Promise<StudioPostDetail | null> | null = null;
    let previewTimer: number | undefined;
    let previewController: AbortController | undefined;
    let lastUploadedUrl = "";
    let tags = [...(initialPost?.tags ?? [])];
    let markdownView: EditorView | null = null;
    let syncingMarkdown = false;
    const localDraftKey = resolveLocalDraftKey();
    let savedSnapshot = snapshot();
    const request = <T = void,>(path: string, init: RequestInit = {}) =>
      studioRequest<T>(path, init, { redirectOnUnauthorized: false });

    loginAgain.href = `/studio/login?next=${encodeURIComponent(window.location.pathname)}`;

    if (!post) restoreLocalDraft();
    renderTags();
    markdownView = await createMarkdownEditor(markdownHost, bodyInput, (value) => {
      bodyInput.value = value;
      if (syncingMarkdown) return;
      markDirty();
      updateDocumentCount();
      schedulePreview(450);
    });
    document.addEventListener("studio:request-editor-selection", (event) => {
      if (!markdownView) return;
      const request = (event as CustomEvent<{
        respond?: (selection: { text: string; prefix: string; suffix: string }) => void;
      }>).detail;
      if (!request?.respond) return;
      const { from, to } = markdownView.state.selection.main;
      request.respond({
        text: markdownView.state.sliceDoc(from, to),
        prefix: markdownView.state.sliceDoc(Math.max(0, from - 240), from),
        suffix: markdownView.state.sliceDoc(to, Math.min(markdownView.state.doc.length, to + 240))
      });
    });
    dropZone.dataset.editorEnhanced = "true";
    updateDocumentCount();
    if (snapshot() !== savedSnapshot) markDirty();
    else syncDirtyFlag();
    syncControls();
    if (!post && bodyInput.value.trim()) schedulePreview(0);

    editorForm.addEventListener("submit", (event) => event.preventDefault());
    editorForm.addEventListener("input", (event) => {
      if (event.target === tagInput) return;
      if (event.target === titleInput && !slugTouched && !slugInput.readOnly) {
        slugInput.value = toSlug(titleInput.value);
      }
      if (event.target === slugInput) slugTouched = Boolean(slugInput.value);
      markDirty();
      if (event.target === bodyInput) schedulePreview(700);
    });

    tagInputShell.addEventListener("click", () => tagInput.focus());
    tagInput.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === "," || event.key === "，" || event.key === "、") {
        event.preventDefault();
        commitTagInput();
        return;
      }
      if (event.key === "Backspace" && !tagInput.value && tags.length > 0) {
        event.preventDefault();
        removeTag(tags.at(-1)!);
      }
    });
    tagInput.addEventListener("blur", commitTagInput);
    tagList.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-remove-tag]");
      if (!button) return;
      removeTag(button.dataset.removeTag ?? "");
    });

    for (const button of editorForm.querySelectorAll<HTMLButtonElement>("[data-markdown-action]")) {
      button.addEventListener("click", () => applyMarkdownAction(button.dataset.markdownAction ?? ""));
    }

    saveButton.addEventListener("click", () => void runCommand(async () => {
      await saveDraft(true);
    }));

    publishButton.addEventListener("click", () => void runCommand(publish));
    unpublishButton.addEventListener("click", () => void runCommand(unpublish));
    archiveButton.addEventListener("click", () => void runCommand(archive));
    reloadButton.addEventListener("click", () => window.location.reload());
    previewButton.addEventListener("click", () => void refreshPreview());

    mediaButton.addEventListener("click", () => mediaPicker.click());
    mediaPicker.addEventListener("change", () => {
      const file = mediaPicker.files?.[0];
      if (file) void uploadImage(file);
    });

    useCoverButton.addEventListener("click", () => {
      if (!lastUploadedUrl) return;
      coverInput.value = lastUploadedUrl;
      coverInput.dispatchEvent(new InputEvent("input", { bubbles: true }));
      mediaResult.hidden = true;
    });

    markdownHost.addEventListener("paste", (event) => {
      const image = Array.from(event.clipboardData?.files ?? []).find((file) => file.type.startsWith("image/"));
      if (!image) return;
      event.preventDefault();
      void uploadImage(image);
    });

    let dragDepth = 0;
    dropZone.addEventListener("dragenter", (event) => {
      if (!hasImage(event.dataTransfer)) return;
      event.preventDefault();
      dragDepth += 1;
      dropOverlay.hidden = false;
    });
    dropZone.addEventListener("dragover", (event) => {
      if (!hasImage(event.dataTransfer)) return;
      event.preventDefault();
      if (event.dataTransfer) event.dataTransfer.dropEffect = "copy";
    });
    dropZone.addEventListener("dragleave", () => {
      dragDepth = Math.max(0, dragDepth - 1);
      if (dragDepth === 0) dropOverlay.hidden = true;
    });
    dropZone.addEventListener("drop", (event) => {
      event.preventDefault();
      dragDepth = 0;
      dropOverlay.hidden = true;
      const image = Array.from(event.dataTransfer?.files ?? []).find((file) => file.type.startsWith("image/"));
      if (image) void uploadImage(image);
    });

    window.addEventListener("beforeunload", (event) => {
      if (!dirty) return;
      event.preventDefault();
    });

    function collectWritePayload(): PostWritePayload {
      return {
        title: titleInput.value.trim(),
        description: descriptionInput.value.trim(),
        publishedAt: resolvePublishedAt(),
        tags: [...tags],
        cover: coverInput.value.trim() || null,
        visibility: visibilityInput.value as PostVisibility,
        body: bodyInput.value
      };
    }

    function snapshot(): string {
      return writeSnapshot(slugInput.value.trim(), collectWritePayload());
    }

    function markDirty() {
      syncVisibilityBadge();
      const nextSnapshot = snapshot();
      dirty = nextSnapshot !== savedSnapshot;
      syncDirtyFlag();
      clearError();
      if (!dirty) {
        window.clearTimeout(autosaveTimer);
        setSaveState("saved", "已保存");
        return;
      }

      setSaveState("dirty", status === "PUBLISHED" ? "未发布修改" : "未保存");
      if (!post) persistLocalDraft();
      scheduleAutosave();
    }

    function commitTagInput() {
      const candidates = tagInput.value.split(/[,，、\n]+/).map(normalizeTag).filter(Boolean);
      if (candidates.length === 0) return;

      let changed = false;
      let validationError = "";
      for (const candidate of candidates) {
        if (candidate.length > 40) {
          validationError = "单个标签不能超过 40 个字符。";
          continue;
        }
        if (tags.some((tag) => tag.toLocaleLowerCase("zh-CN") === candidate.toLocaleLowerCase("zh-CN"))) {
          continue;
        }
        if (tags.length >= 20) {
          validationError = "一篇文章最多添加 20 个标签。";
          break;
        }
        tags.push(candidate);
        changed = true;
      }
      tagInput.value = "";
      if (changed) {
        renderTags();
        markDirty();
      }
      if (validationError) showError(validationError);
    }

    function removeTag(tag: string) {
      const index = tags.indexOf(tag);
      if (index < 0) return;
      tags.splice(index, 1);
      renderTags();
      markDirty();
      tagInput.focus();
    }

    function setTags(values: string[]) {
      const seen = new Set<string>();
      tags = values.map(normalizeTag).filter((tag) => {
        const key = tag.toLocaleLowerCase("zh-CN");
        if (!tag || seen.has(key)) return false;
        seen.add(key);
        return true;
      }).slice(0, 20);
      renderTags();
    }

    function renderTags() {
      const chips = tags.map((tag) => {
        const chip = document.createElement("span");
        chip.className = "tag-chip";
        const label = document.createElement("span");
        label.textContent = tag;
        const remove = document.createElement("button");
        remove.type = "button";
        remove.dataset.removeTag = tag;
        remove.setAttribute("aria-label", `删除标签 ${tag}`);
        remove.textContent = "×";
        chip.append(label, remove);
        return chip;
      });
      tagList.replaceChildren(...chips);
    }

    function updateDocumentCount() {
      const characters = Array.from(bodyInput.value.replace(/\s/g, "")).length;
      const lines = bodyInput.value.split("\n").length;
      documentCount.textContent = `${characters} 字符 · ${lines} 行`;
    }

    function setMarkdownValue(value: string) {
      bodyInput.value = value;
      if (!markdownView || markdownView.state.doc.toString() === value) {
        updateDocumentCount();
        return;
      }
      syncingMarkdown = true;
      markdownView.dispatch({ changes: { from: 0, to: markdownView.state.doc.length, insert: value } });
      syncingMarkdown = false;
      updateDocumentCount();
    }

    function applyMarkdownAction(action: string) {
      if (!markdownView) return;
      applySharedMarkdownAction(markdownView, action);
    }

    async function saveDraft(explicit: boolean): Promise<StudioPostDetail | null> {
      window.clearTimeout(autosaveTimer);
      while (activeSave) await activeSave;
      if (conflicted || (status === "PUBLISHED" && !explicit)) return post;
      if (!dirty && post) {
        setSaveState("saved", "已保存");
        return post;
      }
      if (!validateDocument(explicit)) return null;

      const operation = performSave(explicit);
      activeSave = operation;
      try {
        return await operation;
      } finally {
        if (activeSave === operation) activeSave = null;
      }
    }

    async function performSave(explicit: boolean): Promise<StudioPostDetail | null> {
      setSaveState("saving", "正在保存");
      try {
        const writePayload = collectWritePayload();
        const requestSnapshot = writeSnapshot(slugInput.value.trim(), writePayload);
        const saved = post
          ? await request<StudioPostDetail>(`/studio/posts/${encodeURIComponent(post.slug)}`, {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ ...writePayload, version } satisfies UpdatePostPayload)
            })
          : await request<StudioPostDetail>("/studio/posts", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ slug: slugInput.value.trim(), ...writePayload } satisfies CreatePostPayload)
            });
        applyServerPost(saved, false, requestSnapshot);
        return saved;
      } catch (error) {
        handleRequestError(error, explicit ? "保存失败" : "自动保存失败");
        return null;
      }
    }

    function scheduleAutosave() {
      window.clearTimeout(autosaveTimer);
      if (!dirty || conflicted || busy || status !== "DRAFT" || !validateDocument(false)) return;
      autosaveTimer = window.setTimeout(() => void saveDraft(false), 4_000);
    }

    async function publish() {
      if (!validateDocument(true)) return;

      if (status === "PUBLISHED") {
        const scope = visibilityInput.value === "PUBLIC" ? "所有访客" : "仅你自己";
        if (dirty && !window.confirm(`确定更新文章吗？保存后将${scope}可见。`)) return;
        if (dirty) {
          const updated = await saveDraft(true);
          if (!updated) return;
        }
        if (!conflicted) setSaveState("saved", visibilityInput.value === "PUBLIC" ? "已公开" : "仅自己可见");
        return;
      }

      const publishMessage = visibilityInput.value === "PUBLIC"
        ? "发布后文章会立即出现在公开博客，确定继续吗？"
        : "发布后文章仍然只有登录后的管理员可以阅读，确定继续吗？";
      if (!window.confirm(publishMessage)) return;

      const saved = await saveDraft(true);
      if (!saved || conflicted) return;
      if (dirty) {
        const latest = await saveDraft(true);
        if (!latest || conflicted) return;
      }
      const published = await request<StudioPostDetail>(`/studio/posts/${encodeURIComponent(saved.slug)}/publish`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ version })
      });
      applyServerPost(published, false, savedSnapshot);
      setSaveState("saved", visibilityInput.value === "PUBLIC" ? "已公开" : "仅自己可见");
    }

    async function unpublish() {
      if (!post || status !== "PUBLISHED") return;
      if (!window.confirm("撤回后文章将从公开博客隐藏，并回到草稿。")) return;
      const hadLocalChanges = dirty;
      const draft = await request<StudioPostDetail>(`/studio/posts/${encodeURIComponent(post.slug)}/unpublish`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ version })
      });
      const localSnapshot = snapshot();
      applyServerPost(draft, !hadLocalChanges);
      if (hadLocalChanges) {
        savedSnapshot = writeSnapshot(draft.slug, toWritePayload(draft));
        dirty = localSnapshot !== savedSnapshot;
        const saved = await saveDraft(true);
        if (!saved) return;
      }
      setSaveState("saved", "已撤回");
    }

    async function archive() {
      if (!post) return;
      const warning = dirty && status === "PUBLISHED"
        ? "当前未发布修改不会保留。确定归档这篇文章吗？"
        : "归档后文章将不再公开，确定继续吗？";
      if (!window.confirm(warning)) return;
      if (status === "DRAFT" && dirty) {
        const saved = await saveDraft(true);
        if (!saved) return;
      }
      await request(`/studio/posts/${encodeURIComponent(post.slug)}/archive`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ version })
      });
      dirty = false;
      syncDirtyFlag();
      window.location.assign("/studio/");
    }

    async function runCommand(command: () => Promise<void>) {
      if (busy || conflicted) return;
      window.clearTimeout(autosaveTimer);
      busy = true;
      syncDisabledState();
      try {
        await command();
      } catch (error) {
        handleRequestError(error, "操作失败");
      } finally {
        busy = false;
        syncDisabledState();
        scheduleAutosave();
      }
    }

    async function refreshPreview() {
      window.clearTimeout(previewTimer);
      previewController?.abort();
      previewController = new AbortController();
      previewButton.disabled = true;
      previewState.textContent = "正在生成";
      try {
        const result = await request<{ html: string }>("/studio/preview", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ body: bodyInput.value }),
          signal: previewController.signal
        });
        previewPane.innerHTML = rewriteStudioMedia(result.html)
          || '<div class="preview-placeholder"><span>预览会显示在这里</span></div>';
        previewState.textContent = "已同步";
      } catch (error) {
        if (error instanceof DOMException && error.name === "AbortError") return;
        previewState.textContent = "预览失败";
        showError(error instanceof Error ? error.message : "预览失败");
      } finally {
        previewButton.disabled = false;
      }
    }

    function schedulePreview(delay: number) {
      window.clearTimeout(previewTimer);
      previewState.textContent = "等待更新";
      previewTimer = window.setTimeout(() => void refreshPreview(), delay);
    }

    async function uploadImage(file: File) {
      mediaButton.disabled = true;
      mediaResult.hidden = true;
      try {
        const body = new FormData();
        body.set("image", file);
        const media = await request<SavedMedia>("/studio/media", { method: "POST", body });
        insertAtCursor(`![${escapeImageAlt(file.name)}](${media.url})`);
        lastUploadedUrl = media.url;
        if (setCover.checked || !coverInput.value.trim()) {
          coverInput.value = media.url;
          coverInput.dispatchEvent(new InputEvent("input", { bubbles: true }));
          mediaMessage.textContent = "图片已插入，并设为封面";
          useCoverButton.hidden = true;
        } else {
          mediaMessage.textContent = "图片已插入正文";
          useCoverButton.hidden = false;
        }
        mediaResult.hidden = false;
      } catch (error) {
        showError(error instanceof Error ? error.message : "图片上传失败");
      } finally {
        mediaButton.disabled = false;
        mediaPicker.value = "";
      }
    }

    function insertAtCursor(markdown: string) {
      if (markdownView) {
        const selection = markdownView.state.selection.main;
        const before = markdownView.state.doc.sliceString(0, selection.from);
        const needsLeadingLine = before.length > 0 && !before.endsWith("\n");
        const insertion = `${needsLeadingLine ? "\n" : ""}${markdown}\n`;
        markdownView.dispatch({
          changes: { from: selection.from, to: selection.to, insert: insertion },
          selection: { anchor: selection.from + insertion.length },
          scrollIntoView: true
        });
        markdownView.focus();
        return;
      }
      const before = bodyInput.value.slice(0, bodyInput.selectionStart);
      const insertion = `${before.length > 0 && !before.endsWith("\n") ? "\n" : ""}${markdown}\n`;
      bodyInput.setRangeText(insertion, bodyInput.selectionStart, bodyInput.selectionEnd, "end");
      bodyInput.dispatchEvent(new InputEvent("input", { bubbles: true }));
      bodyInput.focus();
    }

    function applyServerPost(next: StudioPostDetail, updateFields = false, persistedSnapshot?: string) {
      post = next;
      version = next.version;
      document.dispatchEvent(new CustomEvent("studio:content-saved", {
        detail: { contentType: "POST", slug: next.slug, version: next.version }
      }));
      status = next.status;
      slugInput.value = next.slug;
      slugInput.readOnly = true;
      slugTouched = true;
      if (updateFields) {
        titleInput.value = next.title;
        descriptionInput.value = next.description;
        publishedAtInput.value = formatDateTimeInput(new Date(next.publishedAt));
        setTags(next.tags);
        coverInput.value = next.cover ?? "";
        visibilityInput.value = next.visibility;
        setMarkdownValue(next.body);
        previewPane.innerHTML = rewriteStudioMedia(next.html);
      }
      conflicted = false;
      savedSnapshot = persistedSnapshot ?? snapshot();
      dirty = snapshot() !== savedSnapshot;
      syncDirtyFlag();
      localStorage.removeItem(localDraftKey);
      const editPath = `/studio/edit/${encodeURIComponent(next.slug)}/`;
      if (window.location.pathname !== editPath) window.history.replaceState({}, "", editPath);
      loginAgain.href = `/studio/login?next=${encodeURIComponent(editPath)}`;
      const editorContext = document.querySelector<HTMLElement>("[data-editor-context]");
      if (editorContext) editorContext.textContent = next.slug;
      document.title = `编辑：${next.title}｜Speaive`;
      if (dirty) {
        setSaveState("dirty", status === "PUBLISHED" ? "未发布修改" : "未保存");
        scheduleAutosave();
      } else {
        setSaveState("saved", "已保存");
      }
      clearError();
      syncControls();
      document.dispatchEvent(new CustomEvent("studio:post-saved", { detail: { slug: next.slug } }));
    }

    function syncControls() {
      const published = status === "PUBLISHED";
      statusBadge.textContent = published ? "已发布" : "草稿";
      statusBadge.classList.toggle("draft", !published);
      syncVisibilityBadge();
      saveButton.hidden = published;
      unpublishButton.hidden = !published;
      archiveButton.hidden = !post;
      publishLabel.textContent = published ? "更新发布" : "发布";
      syncDisabledState();
    }

    function syncVisibilityBadge() {
      const privatePost = visibilityInput.value === "ADMIN_ONLY";
      visibilityBadge.classList.toggle("private", privatePost);
      visibilityLabel.textContent = privatePost ? "仅自己" : "公开";
    }

    function syncDisabledState() {
      for (const button of [saveButton, publishButton, unpublishButton, archiveButton]) {
        button.disabled = busy || conflicted;
      }
    }

    function setSaveState(state: "dirty" | "saving" | "saved" | "conflict" | "error", label: string) {
      saveIndicator.dataset.state = state;
      saveLabel.textContent = label;
    }

    function handleRequestError(error: unknown, fallback: string) {
      if (error instanceof StudioClientError && error.status === 401) {
        setSaveState("error", "登录已过期");
        showError("登录已过期。请在新窗口重新登录，当前内容会保留在这里。", false, true);
        return;
      }
      if (error instanceof StudioClientError && error.status === 409) {
        conflicted = true;
        window.clearTimeout(autosaveTimer);
        setSaveState("conflict", "冲突");
        showError("文件已在其他位置更新。请重新加载后再继续编辑。", true);
        syncDisabledState();
        return;
      }
      setSaveState("error", "保存失败");
      showError(error instanceof Error ? error.message : fallback);
    }

    function showError(message: string, allowReload = false, allowLogin = false) {
      errorText.textContent = message;
      reloadButton.hidden = !allowReload;
      loginAgain.hidden = !allowLogin;
      errorBox.hidden = false;
    }

    function clearError() {
      if (conflicted) return;
      errorBox.hidden = true;
      reloadButton.hidden = true;
      loginAgain.hidden = true;
    }

    function validateDocument(interactive: boolean): boolean {
      const valid = interactive ? editorForm.reportValidity() : editorForm.checkValidity();
      if (!valid) return false;
      if (!slugInput.value.trim()) {
        if (interactive) {
          slugInput.focus();
          showError("请先填写文章 slug。");
        }
        return false;
      }
      return true;
    }

    function persistLocalDraft() {
      try {
        localStorage.setItem(localDraftKey, snapshot());
      } catch {
        // Browsers may disable local storage; editing can continue without recovery.
      }
    }

    function restoreLocalDraft() {
      try {
        const raw = localStorage.getItem(localDraftKey);
        if (!raw) return;
        const draft = JSON.parse(raw) as Partial<CreatePostPayload>;
        titleInput.value = draft.title ?? "";
        descriptionInput.value = draft.description ?? "";
        slugInput.value = draft.slug ?? "";
        if (Object.hasOwn(draft, "publishedAt")) {
          publishedAtInput.value = "";
          if (draft.publishedAt) {
            const draftPublishedAt = new Date(draft.publishedAt);
            if (!Number.isNaN(draftPublishedAt.valueOf())) {
              publishedAtInput.value = formatDateTimeInput(draftPublishedAt);
            }
          }
        }
        setTags(draft.tags ?? []);
        coverInput.value = draft.cover ?? "";
        visibilityInput.value = draft.visibility ?? "ADMIN_ONLY";
        bodyInput.value = draft.body ?? "";
        slugTouched = Boolean(slugInput.value);
        dirty = true;
        syncDirtyFlag();
        setSaveState("dirty", "已恢复未保存内容");
        scheduleAutosave();
      } catch {
        localStorage.removeItem(localDraftKey);
      }
    }

    function resolvePublishedAt(): string {
      const selectedDateTime = publishedAtInput.value;
      if (!selectedDateTime) return "";
      const selectedInstant = parseDateTimeInput(selectedDateTime);
      if (post?.publishedAt
        && formatDateTimeInput(new Date(post.publishedAt)) === formatDateTimeInput(selectedInstant)) {
        return post.publishedAt;
      }
      return selectedInstant.toISOString();
    }

    function syncDirtyFlag() {
      editorForm.dataset.dirty = String(dirty);
    }
  }

  function normalizeTag(value: string): string {
    return value.trim().replace(/\s+/g, " ");
  }

  function toSlug(value: string): string {
    return toContentSlug(value);
  }

  function toWritePayload(post: StudioPostDetail): PostWritePayload {
    return {
      title: post.title,
      description: post.description,
      publishedAt: post.publishedAt,
      tags: post.tags,
      cover: post.cover,
      visibility: post.visibility,
      body: post.body
    };
  }

  function writeSnapshot(slug: string, payload: PostWritePayload): string {
    const publishedAt = payload.publishedAt
      ? normalizeInstant(payload.publishedAt)
      : payload.publishedAt;
    return JSON.stringify({ slug, ...payload, publishedAt });
  }

  function rewriteStudioMedia(html: string): string {
    return html.replace(
      /src="\/media\/([^"]+)"/g,
      (_match, path: string) => `src="/api/v1/studio/media/${path}"`
    );
  }

  function escapeImageAlt(value: string): string {
    return value.replace(/\.[^.]+$/, "").replace(/[\[\]]/g, "");
  }

  function hasImage(dataTransfer: DataTransfer | null): boolean {
    return Array.from(dataTransfer?.items ?? []).some((item) => item.type.startsWith("image/"));
  }

  function resolveLocalDraftKey(): string {
    try {
      let tabId = sessionStorage.getItem(NEW_DRAFT_TAB_KEY);
      if (!tabId) {
        tabId = createDraftTabId();
        sessionStorage.setItem(NEW_DRAFT_TAB_KEY, tabId);
      }
      return `${NEW_DRAFT_KEY_PREFIX}${tabId}`;
    } catch {
      return `${NEW_DRAFT_KEY_PREFIX}${createDraftTabId()}`;
    }
  }
</script>
