---
interface Props {
  artwork: "paper-bird" | "quiet-desk";
  alt: string;
  eager?: boolean;
  sizes?: string;
}
const { artwork, alt, eager = false, sizes = "(max-width: 720px) 100vw, 50vw" } = Astro.props;
const path = `/images/editorial/${artwork}`;
---
<img src={`${path}-960.webp`} srcset={`${path}-480.webp 480w, ${path}-960.webp 960w, ${path}-1536.webp 1536w`}
  sizes={sizes} width="1536" height="1024" alt={alt}
  loading={eager ? "eager" : "lazy"} fetchpriority={eager ? "high" : "auto"} decoding="async" />
