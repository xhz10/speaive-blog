---
interface Props {
  creating?: boolean;
  name?: string;
  id?: string;
  label?: string;
  autocomplete?: "current-password" | "new-password";
  hint?: string | false;
}
const { creating = false, name = "password", id = `member-${name}`, label = "密码",
  autocomplete = creating ? "new-password" : "current-password",
  hint = creating ? "10–100 个字符，最多 72 字节。忘记密码时，请联系站长获取一次性找回链接。" : false } = Astro.props;
const hintId = `${id}-hint`;
---
<div class="field" data-password-field>
  <label class="field-label" for={id}>{label}</label>
  <div class="auth-password-field"><input class="input" id={id} type="password" name={name} required minlength={creating ? 10 : undefined} maxlength={100} autocomplete={autocomplete} aria-describedby={hint ? hintId : undefined} /><button class="auth-password-toggle" type="button" data-password-toggle aria-controls={id} aria-pressed="false" aria-label={`显示${label}`}>显示</button></div>
  {hint && <span class="auth-input-hint" id={hintId}>{hint}</span>}
</div>
<script>
  for (const group of document.querySelectorAll<HTMLElement>("[data-password-field]")) {
    const input = group.querySelector<HTMLInputElement>("input")!;
    const button = group.querySelector<HTMLButtonElement>("[data-password-toggle]")!;
    const label = group.querySelector("label")?.textContent ?? "密码";
    button.addEventListener("click", () => {
      const reveal = input.type === "password";
      input.type = reveal ? "text" : "password";
      button.textContent = reveal ? "隐藏" : "显示";
      button.setAttribute("aria-label", `${reveal ? "隐藏" : "显示"}${label}`);
      button.setAttribute("aria-pressed", String(reveal));
    });
  }
</script>
