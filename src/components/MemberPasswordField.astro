---
interface Props { creating?: boolean; }
const { creating = false } = Astro.props;
---
<div class="field" data-password-field>
  <label class="field-label" for="member-password">密码</label>
  <div class="auth-password-field"><input class="input" id="member-password" type="password" name="password" required minlength={creating ? 10 : undefined} maxlength={100} autocomplete={creating ? "new-password" : "current-password"} aria-describedby={creating ? "password-hint" : undefined} /><button class="auth-password-toggle" type="button" data-password-toggle aria-controls="member-password" aria-pressed="false" aria-label="显示密码">显示</button></div>
  {creating && <span class="auth-input-hint" id="password-hint">至少 10 个字符。请妥善保存，本站暂不提供邮箱找回。</span>}
</div>
<script>
  for (const group of document.querySelectorAll<HTMLElement>("[data-password-field]")) {
    const input = group.querySelector<HTMLInputElement>("input")!;
    const button = group.querySelector<HTMLButtonElement>("[data-password-toggle]")!;
    button.addEventListener("click", () => {
      const reveal = input.type === "password";
      input.type = reveal ? "text" : "password";
      button.textContent = reveal ? "隐藏" : "显示";
      button.setAttribute("aria-label", reveal ? "隐藏密码" : "显示密码");
      button.setAttribute("aria-pressed", String(reveal));
    });
  }
</script>
