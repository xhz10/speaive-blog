---
import "../styles/account-management.css";
---
<dialog class="account-confirm-dialog" data-account-confirm aria-labelledby="account-confirm-title" aria-describedby="account-confirm-message">
  <h2 id="account-confirm-title" data-confirm-title></h2>
  <p id="account-confirm-message" data-confirm-message></p>
  <div class="account-confirm-actions">
    <button class="button secondary" type="button" data-confirm-cancel autofocus>取消</button>
    <button class="button primary" type="button" data-confirm-accept>确认</button>
  </div>
</dialog>
