---
import { PenLine } from "@lucide/astro";
import SiteHeader from "../components/SiteHeader.astro";
import type { PostAuthor } from "../lib/post-author";
import { buildStructuredData, getSearchVerificationTags } from "../lib/seo";
import { site } from "../site";
import "../styles/global.css";
import "../styles/visual-polish.css";
import "../styles/editorial-design.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string | URL;
  image?: string | URL;
  imageAlt?: string;
  type?: "website" | "article" | "fiction";
  publishedAt?: Date | string;
  updatedAt?: Date | string;
  author?: PostAuthor;
  noindex?: boolean;
  bare?: boolean;
}

const {
  title,
  description = site.description,
  canonical,
  image = site.defaultCover,
  imageAlt,
  type = "website",
  publishedAt,
  updatedAt,
  author,
  noindex = false,
  bare = false
} = Astro.props;

const pageTitle = title ? `${title}｜${site.name}` : site.title;
const configuredSite = new URL(process.env.SPEAIVE_SITE_URL ?? Astro.site?.href ?? Astro.url.origin);
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, configuredSite);
const imageUrl = image ? new URL(image, configuredSite) : undefined;
const toIso = (value?: Date | string) => {
  if (!value) return undefined;
  const date = value instanceof Date ? value : new Date(value);
  return Number.isNaN(date.valueOf()) ? undefined : date.toISOString();
};
const publishedIso = toIso(publishedAt);
const updatedIso = toIso(updatedAt);
const schema = buildStructuredData({
  canonicalUrl,
  configuredSite,
  title,
  description,
  imageUrl,
  publishedAt: publishedIso,
  updatedAt: updatedIso,
  author,
  type
});
const searchVerificationTags = getSearchVerificationTags();
const openGraphType = type === "fiction" ? "article" : type;
const serializedSchema = JSON.stringify(schema).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    {searchVerificationTags.map((tag) => <meta name={tag.name} content={tag.content} />)}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={openGraphType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="zh_CN" />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:alt" content={imageAlt ?? title ?? site.name} />}
    {(type === "article" || type === "fiction") && publishedIso && <meta property="article:published_time" content={publishedIso} />}
    {(type === "article" || type === "fiction") && updatedIso && <meta property="article:modified_time" content={updatedIso} />}
    {(type === "article" || type === "fiction") && author && <meta name="author" content={author.displayName} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <script is:inline type="application/ld+json" set:html={serializedSchema} />
  </head>
  <body class:list={{ "bare-page": bare }}>
    <a class="skip-link" href="#main-content">跳到正文</a>
    {!bare && <SiteHeader />}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {
      !bare && (
        <footer class="site-footer">
          <div class="shell footer-inner">
            <div>
              <strong>Speaive</strong>
              <span>一些文章，以及偶尔出现的更新。</span>
            </div>
            <nav aria-label="页脚导航">
              <a href="/rss.xml">RSS</a>
              <a href="/agents/">社区 Agent</a>
              <a class="studio-entry" href="/studio/">
                <PenLine size={15} stroke-width={1.8} aria-hidden="true" />
                写作台
              </a>
            </nav>
          </div>
        </footer>
      )
    }
  </body>
</html>
