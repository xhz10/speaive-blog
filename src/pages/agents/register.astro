---
import { ArrowRight, KeyRound, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="创建会员账号" noindex>
  <section class="member-auth-page shell">
    <div class="member-auth-intro">
      <span class="member-auth-mark"><KeyRound size={24} stroke-width={1.7} /></span>
      <p class="studio-kicker">Invite only</p>
      <h1>一张邀请码，<br />对应一个真实的创作者。</h1>
      <p>不需要手机号或邮箱。邀请码由站长发放；注册后请联系站长开通写作、发布或加密资格。</p>
      <a href="/agents/login/">已经注册？直接登录</a>
    </div>
    <form class="member-auth-form" data-member-register>
      <span class="member-auth-icon"><ShieldCheck size={20} stroke-width={1.8} /></span>
      <h2>创建会员账号</h2>
      <p>用户名用于登录和个人主页地址，显示名称可以更自然一些。</p>
      <p class="notice error" role="alert" hidden data-auth-error></p>
      <label class="field">
        <span class="field-label">邀请码</span>
        <input class="input" name="invitationCode" required minlength="12" maxlength="100" autocomplete="off" />
      </label>
      <div class="member-auth-grid">
        <label class="field">
          <span class="field-label">用户名</span>
          <input class="input" name="username" required minlength="3" maxlength="50"
            pattern="[a-z0-9][a-z0-9_-]{2,49}" autocomplete="username" />
        </label>
        <label class="field">
          <span class="field-label">显示名称</span>
          <input class="input" name="displayName" required maxlength="100" autocomplete="name" />
        </label>
      </div>
      <label class="field">
        <span class="field-label">密码</span>
        <input class="input" type="password" name="password" required minlength="10" maxlength="100"
          autocomplete="new-password" />
        <span class="field-hint">至少 10 个字符；本站不会要求绑定手机号。</span>
      </label>
      <button class="button primary" type="submit" data-auth-submit>
        注册并进入 <ArrowRight size={17} stroke-width={1.8} />
      </button>
    </form>
  </section>
</BaseLayout>

<script>
  import { StudioClientError, studioRequest } from "../../lib/studio/client";
  import type { MemberSession } from "../../lib/studio/types";

  const form = document.querySelector<HTMLFormElement>("[data-member-register]");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const submit = form.querySelector<HTMLButtonElement>("[data-auth-submit]")!;
    const errorBox = form.querySelector<HTMLElement>("[data-auth-error]")!;
    const data = new FormData(form);
    submit.disabled = true;
    errorBox.hidden = true;
    try {
      await studioRequest<MemberSession>("/account/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          invitationCode: String(data.get("invitationCode") ?? "").trim(),
          username: String(data.get("username") ?? "").trim(),
          displayName: String(data.get("displayName") ?? "").trim(),
          password: String(data.get("password") ?? "")
        })
      }, { redirectOnUnauthorized: false });
      window.location.assign("/writing/");
    } catch (error) {
      errorBox.textContent = error instanceof StudioClientError && error.code === "RATE_LIMITED"
        ? "尝试次数过多，请稍后再试。"
        : error instanceof Error ? error.message : "注册失败，请稍后再试。";
      errorBox.hidden = false;
      submit.disabled = false;
    }
  });
</script>
