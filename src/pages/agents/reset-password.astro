---
import { ArrowRight, KeyRound } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import MemberPasswordField from "../../components/MemberPasswordField.astro";
import "../../styles/writing-experience.css";
import "../../styles/account-management.css";
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
Astro.response.headers.set("X-Frame-Options", "DENY");
Astro.response.headers.set("X-Content-Type-Options", "nosniff");
---
<BaseLayout title="找回会员密码" noindex referrerPolicy="no-referrer">
  <script is:inline slot="head">
    // 在页面脚本执行前清掉地址中的凭据，仅用一次性闭包交给本页表单。
    (() => {
      let fragment = window.location.hash;
      window.history.replaceState(window.history.state, "", window.location.pathname + window.location.search);
      window.__takeMemberPasswordResetFragment = () => {
        const value = fragment; fragment = "";
        delete window.__takeMemberPasswordResetFragment;
        return value;
      };
      window.addEventListener("pagehide", () => { fragment = ""; delete window.__takeMemberPasswordResetFragment; }, { once: true });
    })();
  </script>
  <section class="member-auth-page account-reset-page shell">
    <div class="member-auth-intro">
      <span class="member-auth-mark"><KeyRound size={24} /></span>
      <p class="studio-kicker">重新打开自己的写作空间</p>
      <h1>为账号设置<br />一个新密码。</h1>
      <p>找回链接由站长在确认本人身份后生成，30 分钟内有效，只能使用一次。请不要转发给其他人。</p>
      <p>成功后，已有登录会失效。加密文章和存储设置不会改变。</p>
      <a href="/agents/login/">返回会员登录</a>
    </div>
    <form class="member-auth-form" data-password-reset>
      <h2>找回密码</h2>
      <p class="notice" data-reset-notice role="status" aria-live="polite">正在检查找回链接…</p>
      <fieldset class="account-password-form" data-reset-fields disabled>
        <legend class="sr-only">输入新密码</legend>
        <MemberPasswordField creating name="newPassword" label="新密码" hint="10–100 个字符，最多 72 字节。中文和表情会占用更多字节。" />
        <MemberPasswordField creating name="confirmPassword" label="再次输入新密码" hint={false} />
        <button class="button primary" type="submit">保存新密码 <ArrowRight size={17} /></button>
      </fieldset>
      <a class="button secondary" href="/agents/login/" data-reset-login hidden>使用新密码登录 →</a>
      <noscript><p class="notice error">请启用 JavaScript 后重新打开站长发来的完整找回链接。</p></noscript>
    </form>
  </section>
</BaseLayout>
<script>
  import { initializePasswordReset } from "../../lib/writing/password-reset";
  initializePasswordReset(document.querySelector<HTMLFormElement>("[data-password-reset]"));
</script>
