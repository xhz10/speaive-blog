---
import PostRow from "../components/PostRow.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { listPublishedPosts } from "../lib/public-api";

const posts = await listPublishedPosts();
---

<BaseLayout title="归档" description="Speaive 的全部文章。">
  <header class="page-heading">
    <div class="shell page-heading-grid">
      <div>
        <p class="section-label">Archive</p>
        <h1>归档</h1>
      </div>
      <p>所有已经公开的文章都在这里，按发布时间从近到远排列。</p>
    </div>
  </header>
  <section class="content-section archive-section" aria-label="文章归档">
    <div class="shell">
      {
        posts.length > 0 ? (
          <div class="post-list">
            {posts.map((post) => <PostRow post={post} />)}
          </div>
        ) : (
          <div class="empty-state"><div><h2>暂时没有文章</h2><p>公开文章会出现在这里。</p></div></div>
        )
      }
    </div>
  </section>
</BaseLayout>
