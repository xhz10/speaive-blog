---
import { ArrowLeft, MessageCircle } from "@lucide/astro";
import ArticleVisitTracker from "../../components/ArticleVisitTracker.astro";
import CommentSection from "../../components/CommentSection.astro";
import ReadingRetry from "../../components/ReadingRetry.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDateTime } from "../../lib/date-time";
import { loadArticlePage } from "../../lib/reading-page";

const slug = Astro.params.slug ?? "";
const workSlug = Astro.url.searchParams.get("work") || undefined;
const result = await loadArticlePage(slug, workSlug);
const ready = result.state === "ready" ? result : null;
const post = ready?.post;
const comments = ready?.comments ?? [];
const navigation = ready?.navigation;
if (!ready) Astro.response.status = result.state === "missing" ? 404 : 503;
Astro.response.headers.set("Cache-Control", "no-store");
---

{
  post ? (
    <BaseLayout
      title={post.title}
      description={post.description}
      image={post.cover}
      imageAlt={post.title}
      type="article"
      publishedAt={post.publishedAt}
      updatedAt={post.updatedAt}
      author={post.author}
    >
      <ArticleVisitTracker slug={slug} />
      <article class="article-page">
        <header class="article-header">
          <div class="shell">
            <a class="back-link" href="/archive/">
              <ArrowLeft size={16} stroke-width={1.8} aria-hidden="true" />
              返回归档
            </a>
            <p class="article-kicker">Writing</p>
            <h1>{post.title}</h1>
            {post.description && <p class="article-deck">{post.description}</p>}
            <div class="article-meta">
              <span class="article-author">作者 {post.author.displayName}</span>
              <time datetime={post.publishedAt.toISOString()}>{formatDateTime(post.publishedAt)}</time>
              {
                post.updatedAt && (
                  <span>更新于 <time datetime={post.updatedAt.toISOString()}>{formatDateTime(post.updatedAt)}</time></span>
                )
              }
              <a class="article-discussion-link" href="#comments">
                <MessageCircle size={14} stroke-width={1.7} aria-hidden="true" />
                {ready?.commentsUnavailable ? "评论暂时不可用" : `${comments.length} 条评论`}
              </a>
              {post.tags.length > 0 && (
                <ul class="article-tag-list" aria-label="文章标签">
                  {post.tags.map((tag) => (
                    <li><a href={`/archive/?tag=${encodeURIComponent(tag)}`}>#{tag}</a></li>
                  ))}
                </ul>
              )}
            </div>
          </div>
          {
            post.cover && (
              <figure class="article-cover">
                <img src={post.cover} alt="" width="1600" height="900" />
              </figure>
            )
          }
        </header>
        <div class="article-body reading-width">
          <div class="prose" set:html={post.html} />
        </div>
        {navigation && (
          <nav class="content-work-navigation reading-width" aria-label="作品集连续阅读">
            <a class="content-work-home" href={`/works/${encodeURIComponent(navigation.workSlug)}/`}>收录于《{navigation.workTitle}》</a>
            <div>
              {navigation.previous ? <a href={`${navigation.previous.href}?work=${encodeURIComponent(navigation.workSlug)}`}><small>上一篇</small><strong>{navigation.previous.title}</strong></a> : <span></span>}
              {navigation.next ? <a href={`${navigation.next.href}?work=${encodeURIComponent(navigation.workSlug)}`}><small>下一篇</small><strong>{navigation.next.title}</strong></a> : <span></span>}
            </div>
          </nav>
        )}
        {ready?.navigationUnavailable && <div class="reading-width reading-section-notice">作品集导航暂时没能加载。<ReadingRetry>重新加载</ReadingRetry></div>}
        <CommentSection comments={comments} digest={ready?.digest ?? null}
          unavailable={ready?.commentsUnavailable} digestUnavailable={ready?.digestUnavailable} />
      </article>
    </BaseLayout>
  ) : (
    <BaseLayout title={result.state === "missing" ? "文章不存在" : "文章暂时无法加载"} noindex>
      <section class="not-found">
        <div>
          <h1>{result.state === "missing" ? "404" : "文章暂时没能加载"}</h1>
          <p>{result.state === "missing" ? "这篇文章不存在，或者尚未公开。" : "连接暂时出了点问题，请稍后重新打开。"}</p>
          {result.state === "missing" ? <a class="button primary" href="/archive/">返回归档</a> : <ReadingRetry buttonClass="button primary">重新加载</ReadingRetry>}
        </div>
      </section>
    </BaseLayout>
  )
}
