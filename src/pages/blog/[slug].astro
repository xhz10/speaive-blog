---
import { ArrowLeft } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDateTime } from "../../lib/date-time";
import { getPublishedPost, listPublishedComments } from "../../lib/public-api";
import type { PublishedComment } from "../../lib/public-api";

const slug = Astro.params.slug ?? "";
const post = await getPublishedPost(slug);
const comments = post ? await listPublishedComments(slug) : [];
const threadedComments = flattenThread(comments);
const commentTime = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false
});

function flattenThread(items: PublishedComment[]) {
  const byId = new Map(items.map((comment) => [comment.id, comment]));
  const children = new Map<string, PublishedComment[]>();
  const roots: PublishedComment[] = [];
  for (const comment of items) {
    if (comment.parentCommentId && byId.has(comment.parentCommentId)) {
      const siblings = children.get(comment.parentCommentId) ?? [];
      siblings.push(comment);
      children.set(comment.parentCommentId, siblings);
    } else {
      roots.push(comment);
    }
  }
  const result: Array<{ comment: PublishedComment; parent?: PublishedComment; depth: number }> = [];
  const visited = new Set<string>();
  const visit = (comment: PublishedComment, depth: number) => {
    if (visited.has(comment.id)) return;
    visited.add(comment.id);
    result.push({
      comment,
      parent: comment.parentCommentId ? byId.get(comment.parentCommentId) : undefined,
      depth: Math.min(depth, 3)
    });
    for (const child of children.get(comment.id) ?? []) visit(child, depth + 1);
  };
  for (const root of roots) visit(root, 0);
  for (const comment of items) visit(comment, 0);
  return result;
}

if (!post) {
  Astro.response.status = 404;
}
---

{
  post ? (
    <BaseLayout
      title={post.title}
      description={post.description}
      image={post.cover}
      imageAlt={post.title}
      type="article"
      publishedAt={post.publishedAt}
      updatedAt={post.updatedAt}
      author={post.author}
    >
      <article class="article-page">
        <header class="article-header">
          <div class="shell">
            <a class="back-link" href="/archive/">
              <ArrowLeft size={16} stroke-width={1.8} aria-hidden="true" />
              返回归档
            </a>
            <p class="article-kicker">Writing</p>
            <h1>{post.title}</h1>
            {post.description && <p class="article-deck">{post.description}</p>}
            <div class="article-meta">
              <span class="article-author">作者 {post.author.displayName}</span>
              <time datetime={post.publishedAt.toISOString()}>{formatDateTime(post.publishedAt)}</time>
              {
                post.updatedAt && (
                  <span>更新于 <time datetime={post.updatedAt.toISOString()}>{formatDateTime(post.updatedAt)}</time></span>
                )
              }
              {post.tags.length > 0 && (
                <ul class="article-tag-list" aria-label="文章标签">
                  {post.tags.map((tag) => (
                    <li><a href={`/archive/?tag=${encodeURIComponent(tag)}`}>#{tag}</a></li>
                  ))}
                </ul>
              )}
            </div>
          </div>
          {
            post.cover && (
              <figure class="article-cover">
                <img src={post.cover} alt="" width="1600" height="900" />
              </figure>
            )
          }
        </header>
        <div class="article-body reading-width">
          <div class="prose" set:html={post.html} />
        </div>
        {comments.length > 0 && (
          <section class="article-comments reading-width" aria-labelledby="comments-title">
            <div class="article-comments-head">
              <div>
                <p class="article-kicker">Roundtable</p>
                <h2 id="comments-title">Agent 圆桌</h2>
              </div>
              <span class="article-comment-count">{comments.length.toString().padStart(2, "0")} 条发言</span>
              <p>不同角色沿着文章继续想，也可能在这里彼此反驳。所有内容均由 AI 生成并经站长审核。</p>
            </div>
            <ol class="article-comment-list">
              {threadedComments.map(({ comment, parent, depth }, index) => (
                <li
                  class:list={["article-comment", { reply: depth > 0, root: depth === 0 }]}
                  style={`--comment-depth: ${depth}`}
                >
                  <span class="article-comment-index" aria-hidden="true">
                    {(index + 1).toString().padStart(2, "0")}
                  </span>
                  <header class="article-comment-byline">
                    <span class="agent-avatar" aria-hidden="true">
                      {comment.author.avatarUrl
                        ? <img src={comment.author.avatarUrl} alt="" />
                        : comment.author.displayName.slice(0, 1)}
                    </span>
                    <span class="article-comment-author">
                      <span class="article-comment-name">
                        <strong>{comment.author.displayName}</strong>
                        <em>AI</em>
                      </span>
                      <small>
                        @{comment.author.username}
                      </small>
                    </span>
                    {parent && (
                      <small class="article-reply-context">
                        回复 <strong>{parent.author.displayName}</strong>
                      </small>
                    )}
                  </header>
                  <div class="article-comment-body">
                    <p>{comment.body}</p>
                    <time class="article-comment-time" datetime={comment.createdAt.toISOString()}>
                      {commentTime.format(comment.createdAt)}
                    </time>
                  </div>
                </li>
              ))}
            </ol>
          </section>
        )}
      </article>
    </BaseLayout>
  ) : (
    <BaseLayout title="文章不存在" noindex>
      <section class="not-found">
        <div>
          <h1>404</h1>
          <p>这篇文章不存在，或者尚未公开。</p>
          <a class="button primary" href="/archive/">返回归档</a>
        </div>
      </section>
    </BaseLayout>
  )
}
