---
import { ArrowLeft, ArrowRight, ChartNoAxesColumn, Eye, FileText, MapPin, MonitorSmartphone, ShieldCheck, UsersRound } from "@lucide/astro";
import StudioLayout from "../../../layouts/StudioLayout.astro";
import { fetchStudioApi } from "../../../lib/studio/server";
import { deviceLabels, type VisitAnalytics } from "../../../lib/studio/analytics";
import "../../../styles/studio-analytics.css";

const requestedDays = Number(Astro.url.searchParams.get("days") ?? 7);
const days = [1, 7, 30, 90].includes(requestedDays) ? requestedDays : 7;
const rawPage = Number(Astro.url.searchParams.get("page") ?? 1);
const page = Number.isInteger(rawPage) && rawPage >= 1 && rawPage <= 10000 ? rawPage : 1;
const postId = (Astro.url.searchParams.get("postId") ?? "").slice(0, 36);
const link = (next: { days?: number; page?: number; postId?: string } = {}) => {
  const params = new URLSearchParams({ days: String(next.days ?? days), page: String(next.page ?? 1) });
  const filter = next.postId ?? postId;
  if (filter) params.set("postId", filter);
  return `/studio/analytics/?${params}`;
};
let data: VisitAnalytics | undefined;
let loadError = "";
try {
  const query = new URLSearchParams({ days: String(days), page: String(page), pageSize: "25" });
  if (postId) query.set("postId", postId);
  data = await fetchStudioApi<VisitAnalytics>(Astro.request, `/api/v1/studio/analytics?${query}`);
} catch (error) { loadError = error instanceof Error ? error.message : "访客统计暂时无法加载"; }
const today = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Shanghai", year: "numeric", month: "2-digit", day: "2-digit" }).format(new Date());
const trend = Array.from({ length: days }, (_, index) => {
  const date = new Date(`${today}T00:00:00+08:00`);
  date.setUTCDate(date.getUTCDate() - days + index + 1);
  const key = new Intl.DateTimeFormat("en-CA", { timeZone: "Asia/Shanghai", year: "numeric", month: "2-digit", day: "2-digit" }).format(date);
  return { key, count: data?.daily.find((item) => item.key === key)?.count ?? 0 };
});
const peak = Math.max(1, ...trend.map((day) => day.count));
const format = (value: number) => new Intl.NumberFormat("zh-CN").format(value);
const time = (value: string) => new Intl.DateTimeFormat("zh-CN", { timeZone: "Asia/Shanghai", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false }).format(new Date(value));
const totalPages = Math.max(1, Math.ceil((data?.pageViews ?? 0) / 25));
---

<StudioLayout title="访客统计">
  <div class="analytics-page">
    <header class="analytics-hero">
      <div><p class="studio-kicker">Audience</p><h1>谁在读你的文字</h1><p>从一次打开，到一篇被反复阅读的文章。</p></div>
      <span class="analytics-private"><ShieldCheck size={15} />仅管理员可见</span>
    </header>
    <div class="analytics-toolbar">
      <nav class="analytics-period" aria-label="统计时间范围">
        {[1, 7, 30, 90].map((value) => <a href={link({ days: value })} aria-current={days === value ? "page" : undefined}>{value === 1 ? "今天" : `近 ${value} 天`}</a>)}
      </nav>
      <span>北京时间 · 排除管理员与已识别机器人</span>
    </div>
    {loadError ? <div class="analytics-empty" role="alert"><h2>暂时无法读取统计</h2><p>{loadError}</p><a class="button secondary" href={link({ page })}>重新加载</a></div> : data && <>
      {postId && <div class="analytics-filter"><span>正在查看单篇文章：{data.items[0]?.postTitle ?? "所选文章"}</span><a href={link({ postId: "" })}>查看全部文章 ×</a></div>}
      <div class="analytics-metrics">
        {[{ icon: Eye, name: "文章访问", value: data.pageViews, detail: "实际打开文章的次数" }, { icon: UsersRound, name: "估算访客", value: data.visitors, detail: "按 IP 与浏览器去重" }, { icon: FileText, name: "被阅读文章", value: data.articles, detail: "所选范围内的文章数" }].map(({ icon: Icon, name, value, detail }) => <section><div><span>{name}</span><Icon size={19} stroke-width={1.5} /></div><strong>{format(value)}</strong><small>{detail}</small></section>)}
      </div>
      <section class="analytics-panel analytics-trend">
        <header><div><ChartNoAxesColumn size={18} /><h2>阅读趋势</h2></div><span>每日访问次数</span></header>
        <div class="analytics-bars" role="img" aria-label={`最近 ${days} 天共 ${data.pageViews} 次文章访问`}>
          {trend.map((day) => <div class="analytics-bar" title={`${day.key} · ${day.count} 次`}><span style={`--bar-height: ${day.count / peak * 100}%`}></span><small>{day.key.slice(5)}</small></div>)}
        </div>
        <details class="analytics-trend-data"><summary>查看每日数据</summary><div>{trend.map((day) => <span>{day.key}：{day.count} 次</span>)}</div></details>
      </section>
      <div class="analytics-breakdowns">
        <section class="analytics-panel"><header><div><FileText size={17} /><h2>被读得最多</h2></div><span>前 10 篇</span></header><ol class="analytics-ranking">
          {data.topArticles.map((item, index) => <li><span class="analytics-rank">{String(index + 1).padStart(2, "0")}</span><a href={link({ postId: item.key })}>{item.label}</a><strong>{format(item.count)}</strong></li>)}
          {!data.topArticles.length && <li class="analytics-muted">公开文章被访问后，会显示在这里。</li>}
        </ol></section>
        <section class="analytics-panel"><header><div><MonitorSmartphone size={17} /><h2>阅读设备</h2></div></header><div class="analytics-distribution">
          {data.devices.map((item) => <div><p><span>{deviceLabels[item.key] ?? "未识别"}</span><strong>{format(item.count)} <small>· {Math.round(item.count / Math.max(1, data.pageViews) * 100)}%</small></strong></p><span class="analytics-meter"><i style={`width: ${item.count / Math.max(1, data.pageViews) * 100}%`}></i></span></div>)}
          {!data.devices.length && <p class="analytics-muted">还没有设备数据。</p>}
        </div></section>
        <section class="analytics-panel"><header><div><MapPin size={17} /><h2>来自哪里</h2></div><span>IP 粗略归属地</span></header><ol class="analytics-ranking analytics-locations">
          {data.locations.map((item) => <li><span>{item.label}</span><strong>{format(item.count)}</strong></li>)}
          {!data.locations.length && <li class="analytics-muted">还没有地区数据。</li>}
        </ol></section>
      </div>
      <section class="analytics-panel analytics-visits">
        <header><div><Eye size={18} /><h2>最近访问</h2></div><span>共 {format(data.pageViews)} 条</span></header>
        {data.items.length ? <div class="analytics-table-scroll" tabindex="0" aria-label="访问明细，可横向滚动"><table><thead><tr><th scope="col">访问时间</th><th scope="col">阅读文章</th><th scope="col">设备 / 型号</th><th scope="col">地点 / IP</th><th scope="col">来源站点</th></tr></thead><tbody>
          {data.items.map((visit) => <tr><td><time datetime={visit.visitedAt}>{time(visit.visitedAt)}</time></td><td><a class="analytics-post-title" href={link({ postId: visit.postId })}>{visit.postTitle}</a><small>/{visit.postSlug}</small></td><td><span>{deviceLabels[visit.deviceType] ?? "未识别"} · {visit.deviceModel || "未提供型号"}</span><small>{[visit.operatingSystem, visit.browser].filter(Boolean).join(" · ") || "浏览器未提供信息"}</small></td><td><span>{visit.location}</span><code>{visit.ip || "未知 IP"}</code></td><td>{visit.referrerHost || "直接访问 / 未提供"}</td></tr>)}
        </tbody></table></div> : <div class="analytics-empty"><Eye size={28} stroke-width={1.3} /><h3>等第一位读者来</h3><p>有人打开公开文章后，访问时间、设备和来源就会出现在这里。</p></div>}
        {(totalPages > 1 || page > 1) && <nav class="analytics-pagination" aria-label="访问记录分页">{page > 1 ? <a class="button ghost" href={link({ page: page - 1 })}><ArrowLeft size={15} />上一页</a> : <span></span>}<span>第 {page} / {totalPages} 页</span>{page < totalPages ? <a class="button ghost" href={link({ page: page + 1 })}>下一页<ArrowRight size={15} /></a> : <span></span>}</nav>}
      </section>
      <p class="analytics-footnote">明细保留 {data.retentionDays} 天。共享网络和代理可能影响访客估算；设备型号以浏览器提供的信息为准，iPhone 通常无法识别具体代际。地点未知时，可能是本地 IP 库未安装或没有对应记录。</p>
    </>}
  </div>
</StudioLayout>
