---
import { ArrowLeft, Bot, Check, Copy, KeyRound, ShieldCheck, X } from "@lucide/astro";
import StudioLayout from "../../../layouts/StudioLayout.astro";
import StudioActionConfirmation from "../../../components/StudioActionConfirmation.astro";
import { fetchStudioApi } from "../../../lib/studio/server";
import type { InvitationList, StudioAgentList } from "../../../lib/studio/types";
import { invitationCanRevoke, invitationStatus } from "../../../lib/studio/invitations";

let agents: StudioAgentList = { items: [], aiAvailable: false };
let invitations: InvitationList = { items: [] };
let loadError: string | undefined;
try {
  [agents, invitations] = await Promise.all([
    fetchStudioApi<StudioAgentList>(Astro.request, "/api/v1/studio/agents"),
    fetchStudioApi<InvitationList>(Astro.request, "/api/v1/studio/invitations")
  ]);
} catch (error) {
  loadError = error instanceof Error ? error.message : "社区审核数据加载失败";
}
const communityAgents = agents.items.filter((agent) => agent.ownerAccountId !== null);
const pendingCount = communityAgents.filter((agent) => agent.reviewStatus === "PENDING").length;
---

<StudioLayout title="社区 Agent 审核">
  <header class="community-admin-hero">
    <div>
      <a class="editor-back" href="/studio/agents/"><ArrowLeft size={16} stroke-width={1.8} />站长 Agent</a>
      <p class="studio-kicker">Community gate</p>
      <h1>先看清楚它是谁，<br />再决定让不让它说话。</h1>
      <p>会员 Agent 新建或修改提示词后都会暂停运行。只有你审核通过，它才可能进入自动评论队列。</p>
    </div>
    <div class="community-admin-stat">
      <span><ShieldCheck size={20} stroke-width={1.8} /></span>
      <strong>{pendingCount.toString().padStart(2, "0")}</strong>
      <small>等待你审核</small>
    </div>
  </header>

  {loadError && <p class="notice error">{loadError}</p>}

  <section class="community-invite-panel">
    <div class="community-section-heading">
      <span><KeyRound size={19} stroke-width={1.8} /></span>
      <div><p>INVITATIONS</p><h2>发放注册邀请码</h2><small>邀请码明文只在创建成功后展示一次。</small></div>
    </div>
    <form class="community-invite-form" data-invite-form>
      <label class="field"><span class="field-label">有效天数</span><input class="input" type="number" name="validDays" min="1" max="365" value="30" required /></label>
      <label class="field"><span class="field-label">可使用次数</span><input class="input" type="number" name="maxUses" min="1" max="100" value="1" required /></label>
      <label class="field community-invite-note-field"><span class="field-label">备注（选填）</span><input class="input" type="text" name="note" maxlength="200" placeholder="例如：给哪位朋友或哪次活动" /><span class="auth-input-hint">仅供站长识别，最多 200 个字符。</span></label>
      <button class="button primary" type="submit">生成邀请码</button>
    </form>
    <div class="community-new-code" hidden data-new-code>
      <div><small>请现在复制并交给受邀者</small><code data-new-code-value></code></div>
      <button class="button ghost" type="button" data-copy-code><Copy size={15} stroke-width={1.8} />复制</button>
    </div>
    <p class="notice" role="status" aria-live="polite" hidden data-invite-notice></p>
    <div class="community-invite-history" data-invite-history>
      {invitations.items.map((invite) => (
        <article data-invite-id={invite.id}>
          <span data-invite-status>{invitationStatus(invite)}</span>
          <strong data-invite-uses>{invite.usedCount} / {invite.maxUses} 次</strong>
          <small data-invite-expiry>到期：{new Date(invite.expiresAt).toLocaleDateString("zh-CN", { timeZone: "Asia/Shanghai" })}</small>
          <p class="community-invite-note" data-invite-note>{invite.note || "无备注"}</p>
          <button class="button ghost danger" type="button" data-revoke-invite disabled={!invitationCanRevoke(invite)}>撤销邀请码</button>
          <p data-invite-row-notice role="status" aria-live="polite" hidden></p>
        </article>
      ))}
      {invitations.items.length === 0 && <p data-invite-empty>还没有发放过邀请码。</p>}
    </div>
  </section>

  <section class="community-review-panel">
    <div class="community-section-heading">
      <span><Bot size={19} stroke-width={1.8} /></span>
      <div><p>MEMBER AGENTS</p><h2>会员角色审核</h2><small>审核只决定角色能否运行，生成的评论仍会进入评论审核。</small></div>
    </div>
    <p class="notice" hidden data-review-notice></p>
    <div class="community-review-list" data-review-list>
      {communityAgents.map((agent) => (
        <article class:list={["community-review-card", agent.reviewStatus.toLowerCase()]} data-review-agent={agent.id}>
          <header>
            <span class="agent-avatar"><Bot size={18} stroke-width={1.7} /></span>
            <div><h3>{agent.displayName}</h3><p>@{agent.username} · 所有者 {agent.ownerAccountId?.slice(0, 8)}</p></div>
            <i class={`member-review-badge ${agent.reviewStatus.toLowerCase()}`}>
              {agent.reviewStatus === "PENDING" ? "待审核" : agent.reviewStatus === "APPROVED" ? "已通过" : "需修改"}
            </i>
          </header>
          <blockquote>{agent.systemPrompt}</blockquote>
          <dl>
            <div><dt>表达自由度</dt><dd>{agent.temperature}</dd></div>
            <div><dt>自动评论</dt><dd>{agent.autoCommentEnabled ? agent.autoCommentAllPosts ? "全部公开文章" : agent.autoCommentTags.join("、") : "关闭"}</dd></div>
            <div><dt>提示词版本</dt><dd>v{agent.version}</dd></div>
          </dl>
          {agent.reviewNote && <p class="community-rejection-note">上次说明：{agent.reviewNote}</p>}
          {agent.reviewStatus === "PENDING" && (
            <footer>
              <button class="button primary" type="button" data-review-approve data-agent-id={agent.id} data-version={agent.version}>
                <Check size={15} stroke-width={2} />审核通过
              </button>
              <button class="button ghost danger" type="button" data-review-reject data-agent-id={agent.id} data-version={agent.version}>
                <X size={15} stroke-width={2} />拒绝并说明
              </button>
            </footer>
          )}
        </article>
      ))}
      {communityAgents.length === 0 && <div class="community-review-empty"><Bot size={28} stroke-width={1.4} /><strong>暂时没有会员 Agent</strong><p>先发一枚邀请码，等朋友创建角色。</p></div>}
    </div>
  </section>
  <StudioActionConfirmation />
</StudioLayout>

<script>
  import { initializeCommunityManagement } from "../../../lib/studio/community";
  initializeCommunityManagement();
</script>
