---
import { UsersRound, ArrowUpRight } from "@lucide/astro";
import StudioLayout from "../../../layouts/StudioLayout.astro";
import StudioActionConfirmation from "../../../components/StudioActionConfirmation.astro";
import { fetchStudioApi } from "../../../lib/studio/server";
import type { WritingAccount } from "../../../lib/writing/types";
import "../../../styles/member-writing.css";
let members: WritingAccount[] = []; let error = "";
try { members = (await fetchStudioApi<{ items: WritingAccount[] }>(Astro.request, "/api/v1/studio/members")).items; }
catch (e) { Astro.response.status = 503; error = e instanceof Error ? e.message : "无法读取会员账号"; }
---
<StudioLayout title="会员与写作权限">
  <div class="writing-admin-page"><header class="writing-hero"><div><p class="writing-eyebrow">会员管理</p><h1>让朋友也能在这里写作。</h1><p>写作、公开发布、加密资格分别设置。是否开启加密，由作者自己决定。</p></div><a class="button secondary" href="/studio/community/">邀请码与社区管理 →</a></header>
  {error ? <p class="notice error" role="alert">{error}</p> : members.length ? <div class="writing-member-grid">{members.map((member) => (
    <form class="writing-paper writing-member-card" data-member-permissions data-username={member.username} data-version={member.version}>
      <header><span class="writing-avatar">{member.displayName.slice(0, 1)}</span><div><h2>{member.displayName}</h2><p>@{member.username}</p></div><a href={`/profile/${encodeURIComponent(member.username)}/`} target="_blank" rel="noreferrer" aria-label={`${member.displayName}的个人主页`}><ArrowUpRight size={18} /></a></header>
      <label class="field"><span class="field-label">账号身份</span><select class="input" name="role"><option value="READER" selected={member.role === "READER"}>普通会员 · 可使用社区 Agent</option><option value="WRITER" selected={member.role === "WRITER"}>作者 · 可以编辑自己的文章</option></select></label>
      <label class="writing-check"><input type="checkbox" name="canPublish" checked={member.canPublish} disabled={member.role !== "WRITER"} /><span>允许公开发布<small>文章可以展示在该作者的个人主页</small></span></label>
      <label class="writing-check"><input type="checkbox" name="encryptionAllowed" checked={member.encryptionAllowed} disabled={member.contentEncrypted} /><span>开放加密存储<small>{member.contentEncrypted ? "作者正在使用加密，不能直接撤销资格" : "作者可在自己的设置中开启或关闭"}</small></span></label>
      <div class="writing-member-card-foot"><span class="writing-badge">{member.contentEncrypted ? "已开启加密" : "普通存储"}</span><button class="button secondary" type="submit">保存权限</button></div>
      <p class="writing-notice" data-permissions-notice role="status" aria-live="polite" hidden></p>
      <section class="account-recovery" aria-label={`${member.displayName}的密码找回`}>
        <h3>帮助会员找回密码</h3>
        <p>请先通过你们熟悉的方式确认是本人。生成链接不会立即改变密码或退出已有登录；使用成功后，旧登录才会失效。</p>
        <button class="button secondary" type="button" data-create-password-reset>生成一次性找回链接</button>
        <p class="writing-notice" data-recovery-notice role="status" aria-live="polite" hidden></p>
        <div class="account-recovery-result" data-recovery-result hidden>
          <p data-recovery-details></p>
          <code data-recovery-url></code>
          <div class="account-recovery-actions"><button class="button secondary" type="button" data-copy-password-reset>复制一次</button><button class="button ghost" type="button" data-dismiss-password-reset>隐藏链接</button></div>
          <p>链接只在本页展示。刷新后无法再查看，重新生成会替代该账号的旧链接。请只交给已确认身份的本人。</p>
        </div>
      </section>
    </form>
  ))}</div> : <div class="writing-empty"><UsersRound size={32} /><h2>还没有会员账号</h2><p>先在社区管理中创建邀请码，朋友注册后就会出现在这里。</p><a class="button secondary" href="/agents/register/" target="_blank" rel="noreferrer">查看注册页面</a></div>}
  <p class="writing-hint">撤销发布资格会阻止后续发布和公开更新；改回普通会员会撤回公开文章并关闭个人主页。已有内容仍属于原作者。管理员原有文章不受这些设置影响。</p></div>
  <StudioActionConfirmation />
</StudioLayout>
<script>
  import { initializeMemberManagement } from "../../../lib/studio/members";
  initializeMemberManagement();
</script>
