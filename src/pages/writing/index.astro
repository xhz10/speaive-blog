---
import { Plus, LockKeyhole, ArrowUpRight, FileText, ArchiveRestore } from "@lucide/astro";
import WritingLayout from "../../layouts/WritingLayout.astro";
import { fetchStudioApi } from "../../lib/studio/server";
import { type WritingAccount, type WritingPosts, pageNumber, writingDate, writingStatus, writingFilters, writingFilter } from "../../lib/writing/types";
const page = pageNumber(Astro.url.searchParams.get("page"));
const filter = writingFilter(Astro.url.searchParams.get("filter"));
const archived = filter === "ARCHIVED";
const pageHref = (value: number) => `?filter=${filter}&page=${value}`;
let account: WritingAccount | undefined; let posts: WritingPosts | undefined; let error = "";
try { [account, posts] = await Promise.all([
  fetchStudioApi<WritingAccount>(Astro.request, "/api/v1/account/writing/settings"),
  fetchStudioApi<WritingPosts>(Astro.request, `/api/v1/account/writing/posts?page=${page}&filter=${filter}`)
]); } catch (e) { Astro.response.status = 503; error = e instanceof Error ? e.message : "暂时无法读取文章"; }
---
<WritingLayout title="我的文章" username={account?.role === "WRITER" ? account.username : undefined}>
  {Astro.url.searchParams.get("reauth") === "1" && <p class="auth-return-note" role="status">已重新登录。请回到原来的编辑窗口继续保存，那里还保留着未保存的文字。</p>}
  <header class="writing-hero"><div><p class="writing-eyebrow">{account?.displayName ?? "我的写作空间"}</p><h1>把想说的，写下来。</h1><p>先写给自己。准备好了，再与读者见面。</p></div>{account?.role === "WRITER" && <a class="button primary" href="/writing/new/"><Plus size={17} />写一篇文章</a>}</header>
  {error ? <div class="writing-empty" role="alert"><h2>暂时无法打开写作空间</h2><p>{error}</p><a class="button secondary" href={pageHref(page)}>重新加载</a></div> : account && posts && <>
    <div class="writing-storage-strip"><span><LockKeyhole size={16} />{account.contentEncrypted ? "文章与历史版本已加密存储" : "当前使用普通存储"}</span><a href="/writing/settings/">管理存储设置 →</a></div>
    <details class="writing-onboarding" open={account.role !== "WRITER" || (filter === "ALL" && posts.total === 0)}><summary>从注册到第一篇文章，你现在在哪一步？</summary><ol>
      <li><strong>账号已准备好</strong><p>你是 @{account.username}，显示名称是 {account.displayName}。</p></li>
      <li><strong>{account.role === "WRITER" ? "可以开始写作" : "等待开通作者权限"}</strong><p>{account.role === "WRITER" ? "新文章先是草稿。点击保存后，下次登录还能继续写。" : "把用户名告诉站长，开通作者权限后这里会出现写作入口。"}</p></li>
      <li><strong>{account.role !== "WRITER" ? "发布权限单独设置" : account.canPublish ? "准备好后可以公开" : "目前先写给自己"}</strong><p>{account.role !== "WRITER" ? "开通作者后，还需要发布资格才能让文章对外可读；你也可以一直保留为私密草稿。" : account.canPublish ? "公开发布后，读者可以在个人主页和“朋友的文字”找到作品。" : "公开发布需要站长另行授权，未开通也不影响保存草稿。"}</p></li>
    </ol><p><a href="/writing/settings/">查看权限与加密设置 →</a>{account.role !== "WRITER" && <a href="/writing/">已联系站长？刷新权限</a>}</p></details>
    <section class="writing-paper"><header class="writing-section-title"><h2>{archived ? "归档的文章" : "我的文章"} <span>{posts.total}</span></h2><span>{archived ? "找回后是私密草稿，不会重新公开" : "最近修改优先 · 草稿仅自己可见"}</span></header>
    <nav class="writing-filter-nav" aria-label="文章状态筛选">{writingFilters.map(item => <a href={`?filter=${item.value}`} aria-current={filter === item.value ? "page" : undefined}>{item.label}</a>)}</nav>
    <p class="writing-notice" data-list-notice role="status" hidden></p>
    {posts.items.length ? <div class="writing-posts">{posts.items.map((post) => <article class="writing-post-row"><div><span class:list={["writing-badge", { public: !archived && writingStatus(post) === "已公开" }]}>{archived ? "已归档" : writingStatus(post)}</span><h3>{archived ? post.title : <a href={`/writing/${post.slug}/`}>{post.title}</a>}</h3><p>{post.description || "还没有填写摘要"}</p><small>{writingDate(post.updatedAt)} {archived ? "归档" : "更新"}{post.tags.length > 0 && ` · ${post.tags.join(" / ")}`}</small></div>{archived ? <button class="button secondary writing-recover" data-recover-slug={post.slug} data-recover-version={post.version} data-recover-title={post.title} data-username={account.username} disabled={account.role !== "WRITER"}><ArchiveRestore size={17} />找回</button> : <a class="writing-open" href={`/writing/${post.slug}/`} aria-label={`打开：${post.title}`}><ArrowUpRight size={21} /></a>}</article>)}</div> : <div class="writing-empty"><FileText size={32} stroke-width={1.3} /><h2>{page > 1 ? "这一页没有文章" : archived ? "还没有归档的文章" : account.role !== "WRITER" ? "等待开启你的第一篇" : filter === "PUBLIC" ? "还没有公开的作品" : filter === "PRIVATE" ? "目前没有私密文章" : "这里会收好你的每一篇文字"}</h2><p>{page > 1 ? "返回前一页继续查看。" : archived ? "归档只是收起来，需要时可以在这里找回。" : account.role !== "WRITER" ? "站长开通作者权限后，就可以保存和管理自己的文章。" : "随笔、故事，或者还没想好名字的念头，都可以先存成草稿。"}</p>{page > 1 ? <a class="button secondary" href={pageHref(page - 1)}>返回上一页</a> : account.role === "WRITER" && !archived && <a class="button secondary" href="/writing/new/">写一篇草稿</a>}</div>}
    {(posts.total > posts.pageSize || page > 1) && <nav class="writing-pagination" aria-label="文章分页">{page > 1 ? <a href={pageHref(page - 1)}>← 上一页</a> : <span />}<span>第 {page} 页</span>{page * posts.pageSize < posts.total ? <a href={pageHref(page + 1)}>下一页 →</a> : <span />}</nav>}
    </section>
  </>}
</WritingLayout>
<script>
  import "../../lib/writing/archive";
</script>
